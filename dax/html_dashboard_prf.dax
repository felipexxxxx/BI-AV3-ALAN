HTML Dashboard PRF =
VAR _Json = [JSON Gold Dashboard PRF]
VAR _Seguro = SUBSTITUTE(_Json, "<", "\u003c")
VAR _Inicio = "<div id=""ld-prf-root"" class=""ld-root"" data-theme=""dark""><style>.ld-root{--ld-bg:#0b121b;--ld-panel:#131e2b;--ld-soft:#192736;--ld-fg:#f1f5fa;--ld-muted:#aebed0;--ld-line:#2c3c4e;--ld-accent:#43d6c4;--ld-accent-fg:#082722;--ld-accent-soft:#163b3c;--ld-amber:#ffc66d;--ld-danger:#ff8d99;--ld-fatal-bg:#30212c;--ld-grave-bg:#302b1e;--ld-median:#baa7ff;--ld-radius:14px;--ld-gap:18px;--ld-font:'Segoe UI',Aptos,Arial,sans-serif;--ld-shadow:0 6px 24px #00000014;color:var(--ld-fg);background:var(--ld-bg);font-family:var(--ld-font);font-size:14px;line-height:1.45;padding:24px;box-sizing:border-box;width:100%;min-width:0;color-scheme:dark;overflow-x:clip}
.ld-root[data-theme=light]{--ld-bg:#f1f4f8;--ld-panel:#ffffff;--ld-soft:#eaf0f6;--ld-fg:#172c41;--ld-muted:#52647a;--ld-line:#d4dfe9;--ld-accent:#087d73;--ld-accent-fg:#ffffff;--ld-accent-soft:#e1f3ef;--ld-amber:#946000;--ld-danger:#b52c46;--ld-fatal-bg:#fff0f3;--ld-grave-bg:#fff5df;--ld-median:#6744a8;--ld-shadow:0 6px 24px #17324b09;color-scheme:light}
.ld-root *{box-sizing:border-box}.ld-root button,.ld-root select{font:inherit}.ld-root button{cursor:pointer}.ld-root button:focus-visible,.ld-root select:focus-visible,.ld-root [tabindex]:focus-visible{outline:3px solid var(--ld-accent);outline-offset:3px}.ld-root h1,.ld-root h2,.ld-root h3,.ld-root p{margin:0}.ld-root svg{display:block;max-width:100%}.ld-root [hidden]{display:none!important}.ld-track{display:block;width:100%}
.ld-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:20px}.ld-eyebrow{display:flex;align-items:center;gap:9px;text-transform:uppercase;letter-spacing:.15em;font-size:11px;font-weight:700;color:var(--ld-accent);margin-bottom:6px}.ld-mark{width:22px;height:16px;display:inline-flex;gap:4px;transform:skewX(-14deg)}.ld-mark i{width:6px;background:var(--ld-accent);display:block}.ld-mark i:nth-child(2){opacity:.5}.ld-title{font-size:28px;font-weight:650;line-height:1.16;letter-spacing:-.025em}.ld-subtitle{font-size:13px;color:var(--ld-muted);margin-top:7px!important}.ld-tools{text-align:right;flex-shrink:0}.ld-theme{border:1px solid var(--ld-line);border-radius:20px;padding:7px 13px;background:var(--ld-panel);color:var(--ld-fg);font-size:12px}.ld-updated{font-size:11px;color:var(--ld-muted);margin-top:8px!important}.ld-rule{height:2px;background:linear-gradient(90deg,var(--ld-accent),transparent);margin-bottom:20px}
.ld-filters{display:grid;grid-template-columns:repeat(7,minmax(0,1fr)) auto;gap:10px;align-items:end;margin-bottom:12px}.ld-field{display:grid;gap:5px;font-size:11px;color:var(--ld-muted);font-weight:600;letter-spacing:.02em;min-width:0}.ld-select{width:100%;min-width:0;max-width:100%;border:1px solid var(--ld-line);border-radius:8px;padding:9px 25px 9px 10px;background:var(--ld-panel);color:var(--ld-fg);font-size:12px!important;text-overflow:ellipsis}.ld-clear{background:transparent;border:1px solid var(--ld-line);border-radius:8px;color:var(--ld-fg);height:37px;padding:0 12px;font-size:12px!important;white-space:nowrap}.ld-clear:hover{background:var(--ld-soft)}.ld-ticker{display:flex;gap:14px;align-items:center;border-left:3px solid var(--ld-accent);background:var(--ld-accent-soft);padding:9px 12px;border-radius:0 8px 8px 0;font-size:12px;min-height:38px;margin-bottom:16px}.ld-ticker-label{font-size:10px;font-weight:700;letter-spacing:.12em;white-space:nowrap}.ld-ticker-values{display:flex;gap:14px;flex-wrap:wrap;min-width:0}.ld-ticker-values span+span{border-left:1px solid var(--ld-line);padding-left:14px}.ld-selection{color:var(--ld-muted);font-size:11px;margin-top:-8px!important;margin-bottom:12px!important;min-height:16px}
.ld-kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:var(--ld-gap)}.ld-kpi{background:var(--ld-panel);padding:16px;border-radius:var(--ld-radius);box-shadow:var(--ld-shadow);min-width:0;position:relative;border-top:2px solid transparent}.ld-kpi:first-child{border-top-color:var(--ld-accent)}.ld-kpi-label{color:var(--ld-muted);font-size:12px;min-height:34px;display:block}.ld-kpi-value{font-size:30px;line-height:1.1;font-weight:650;letter-spacing:-.04em;font-variant-numeric:tabular-nums;display:block;white-space:nowrap}.ld-kpi-detail{font-size:11px;color:var(--ld-muted);display:block;margin-top:8px;min-height:16px}.ld-kpi[data-metric=graves] .ld-kpi-value,.ld-kpi[data-metric=mortes] .ld-kpi-value{color:var(--ld-amber)}
.ld-main-grid{display:grid;grid-template-columns:minmax(0,1.9fr) minmax(270px,1fr);gap:var(--ld-gap);margin-bottom:var(--ld-gap)}.ld-panel{background:var(--ld-panel);border-radius:var(--ld-radius);padding:18px;min-width:0;box-shadow:var(--ld-shadow)}.ld-panel-header{display:flex;justify-content:space-between;align-items:start;gap:14px;margin-bottom:12px}.ld-panel h2{font-size:15px;font-weight:650;letter-spacing:-.01em}.ld-panel-desc{font-size:11px;color:var(--ld-muted);margin-top:3px!important}.ld-legend{display:flex;gap:12px;flex-wrap:wrap;font-size:10px;color:var(--ld-muted)}.ld-legend span{display:flex;gap:5px;align-items:center;white-space:nowrap}.ld-dot{width:8px;height:8px;background:var(--ld-accent);display:inline-block}.ld-dot.ld-line-dot{height:2px;width:14px;background:var(--ld-amber)}.ld-monthly{width:100%;height:244px}.ld-monthly text{font:11px var(--ld-font);fill:var(--ld-muted)}.ld-grid-line{stroke:var(--ld-line);stroke-width:1}.ld-bar{fill:var(--ld-accent);opacity:.72;transition:opacity .15s}.ld-bar:hover{opacity:1}.ld-curve{stroke:var(--ld-amber);stroke-width:2.2;fill:none}.ld-line-point{fill:var(--ld-amber);stroke:var(--ld-panel);stroke-width:1.5}.ld-chart-empty{display:flex;align-items:center;justify-content:center;min-height:180px;color:var(--ld-muted);font-size:13px;text-align:center}
.ld-readout{border-top:2px solid var(--ld-accent)}.ld-insight-number{font-size:40px;font-weight:650;line-height:1.1;letter-spacing:-.04em;color:var(--ld-accent);margin:12px 0 7px!important}.ld-insight-title{font-size:13px;font-weight:600;margin-bottom:8px!important}.ld-insight-copy{color:var(--ld-muted);font-size:12px}.ld-action{margin-top:16px;padding-top:12px;border-top:1px solid var(--ld-line);font-size:12px}.ld-action strong{display:block;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ld-accent);margin-bottom:5px}.ld-bottom-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:var(--ld-gap);margin-bottom:var(--ld-gap)}.ld-rank-list{display:grid;gap:13px}.ld-rank{border:0;width:100%;text-align:left;background:transparent;color:var(--ld-fg);padding:0;display:block}.ld-rank-label{display:flex;justify-content:space-between;gap:12px;font-size:12px;margin-bottom:4px}.ld-rank-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;max-width:84%;font-size:12px}.ld-rank-value{font-variant-numeric:tabular-nums;font-size:12px}.ld-track{height:5px;background:var(--ld-soft);border-radius:3px;overflow:hidden}.ld-track i{display:block;height:100%;background:var(--ld-accent);border-radius:3px;transition:width .25s}.ld-rank:hover .ld-rank-name{text-decoration:underline}.ld-type-list{display:grid;gap:9px}.ld-type-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;font-size:12px;padding:7px 0;border-bottom:1px solid var(--ld-line)}.ld-type-row:last-child{border:0}.ld-type-row small{color:var(--ld-muted);font-size:11px}.ld-type-row b{font-weight:600;font-variant-numeric:tabular-nums}.ld-type-label{min-width:0;overflow-wrap:anywhere}.ld-small-note{font-size:10px;color:var(--ld-muted);margin-top:10px!important}
.ld-table-panel{padding-bottom:10px}.ld-table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:12px}.ld-table th{text-align:left;font-weight:500;font-size:10px;letter-spacing:.04em;color:var(--ld-muted);padding:8px 10px;border-bottom:1px solid var(--ld-line)}.ld-table th:first-child{width:34%;padding-left:0}.ld-table td{padding:9px 10px;border-bottom:1px solid var(--ld-line);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.ld-table td:first-child{padding-left:0}.ld-table tr:last-child td{border:0}.ld-num{text-align:right!important}.ld-table .ld-severity{color:var(--ld-amber)}.ld-trecho-name{font-weight:600;display:block}.ld-trecho-sub{display:block;color:var(--ld-muted);font-size:10px;margin-top:2px}.ld-table-meta{font-size:10px;color:var(--ld-muted);margin-top:9px;display:flex;justify-content:space-between;gap:12px}.ld-footer{display:flex;justify-content:space-between;gap:18px;font-size:10px;color:var(--ld-muted);margin-top:14px}.ld-footer p{max-width:78%}.ld-empty{padding:45px 20px;text-align:center;border:1px dashed var(--ld-line);border-radius:var(--ld-radius);margin-bottom:var(--ld-gap)}.ld-empty h2{font-size:19px;margin-bottom:7px}.ld-empty p{color:var(--ld-muted);font-size:13px}.ld-tooltip{position:fixed;z-index:9999;pointer-events:none;border:1px solid var(--ld-line);background:var(--ld-panel);color:var(--ld-fg);border-radius:8px;padding:9px 12px;box-shadow:var(--ld-shadow);font-size:12px;max-width:270px;white-space:pre-line}.ld-status{display:inline-flex;align-items:center;gap:5px}.ld-status:before{content:'';width:5px;height:5px;background:var(--ld-accent);border-radius:50%}
@media(min-width:1600px){.ld-monthly{height:242px}.ld-kpi-value{font-size:35px}.ld-panel{padding:20px}}
@media(max-width:1050px){.ld-root{padding:18px;--ld-gap:14px}.ld-filters{grid-template-columns:repeat(3,minmax(0,1fr))}.ld-kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.ld-main-grid{grid-template-columns:minmax(0,1.5fr) minmax(240px,1fr)}.ld-bottom-grid{grid-template-columns:1fr 1fr}.ld-bottom-grid>.ld-panel:last-child{grid-column:1/-1}.ld-title{font-size:25px}}
@media(max-width:720px){.ld-main-grid{grid-template-columns:1fr}.ld-bottom-grid{grid-template-columns:1fr}.ld-bottom-grid>.ld-panel:last-child{grid-column:auto}.ld-head{gap:12px}.ld-title{font-size:22px}.ld-tools{max-width:130px}.ld-updated{font-size:10px}.ld-ticker{align-items:flex-start;flex-direction:column;gap:5px}.ld-ticker-values{gap:7px}.ld-ticker-values span+span{padding-left:7px}.ld-panel-header{flex-wrap:wrap}.ld-footer{flex-direction:column;gap:5px}.ld-footer p{max-width:100%}.ld-table th:first-child{width:31%}.ld-table td,.ld-table th{padding:8px 5px;font-size:11px}}
@media(max-width:480px){.ld-root{padding:12px;--ld-gap:12px}.ld-head{flex-direction:column}.ld-tools{max-width:none;width:100%;display:flex;align-items:center;justify-content:space-between;text-align:left;gap:12px}.ld-updated{margin:0!important}.ld-filters{grid-template-columns:repeat(2,minmax(0,1fr))}.ld-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.ld-kpi{padding:13px}.ld-kpi-value{font-size:28px}.ld-kpi-label{font-size:11px;min-height:31px}.ld-panel{padding:14px}.ld-title{font-size:24px}.ld-monthly{height:205px}.ld-table thead{display:none}.ld-table tbody{display:grid;gap:10px}.ld-table tr{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));background:var(--ld-soft);padding:10px;border-radius:9px;gap:6px}.ld-table td{border:0!important;padding:0!important;text-align:left!important;font-size:12px}.ld-table td:first-child{grid-column:1/-1;margin-bottom:4px}.ld-table td:not(:first-child):before{content:attr(data-label);display:block;color:var(--ld-muted);font-size:10px}.ld-trecho-sub{font-size:11px}.ld-table-meta{flex-direction:column;gap:3px}.ld-ticker-values span+span{border:0;padding:0}.ld-ticker-values span{display:block;width:100%}}
@media(prefers-reduced-motion:reduce){.ld-root *{animation:none!important;transition:none!important}}
.ld-rank-list{min-width:0;grid-template-columns:minmax(0,1fr)}.ld-rank{min-width:0;max-width:100%}.ld-rank-label{min-width:0}.ld-rank-value{flex-shrink:0}
.ld-dot.ld-median-dot{width:16px;height:0;background:transparent;border-top:2px dashed var(--ld-median)}.ld-median-line{stroke:var(--ld-median);stroke-width:1.6;stroke-dasharray:5 4;pointer-events:none}.ld-monthly .ld-axis-title{font-size:10px;font-weight:600}.ld-chart-note{font-size:11px;color:var(--ld-muted);margin-top:8px!important}.ld-ran" &
"k-context{display:block;color:var(--ld-muted);font-size:11px;margin-top:5px}.ld-executive-list{padding-left:16px;margin:12px 0 0;display:grid;gap:7px;font-size:12px;color:var(--ld-muted)}.ld-executive-list strong{color:var(--ld-fg);font-weight:600}.ld-context-grid{display:grid;grid-template-columns:minmax(240px,1fr) minmax(0,2fr);gap:var(--ld-gap);margin-bottom:var(--ld-gap)}.ld-outcome-alert{font-size:12px;color:var(--ld-muted);margin-bottom:12px!important}.ld-pista-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ld-pista-card{background:var(--ld-soft);border-radius:10px;padding:12px;min-width:0}.ld-pista-card[data-outcome=fatal]{background:var(--ld-fatal-bg)}.ld-pista-card[data-outcome=grave]{background:var(--ld-grave-bg)}.ld-pista-head{display:flex;justify-content:space-between;gap:8px;align-items:start}.ld-pista-head h3{font-size:13px;font-weight:600}.ld-pista-head strong{font-size:17px;font-variant-numeric:tabular-nums}.ld-outcome-tag{display:block;font-size:10px;color:var(--ld-muted);margin:8px 0 10px}.ld-pista-card[data-outcome=fatal] .ld-outcome-tag{color:var(--ld-danger)}.ld-pista-card[data-outcome=grave] .ld-outcome-tag{color:var(--ld-amber)}.ld-pista-numbers{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0}.ld-pista-numbers dt{font-size:10px;color:var(--ld-muted)}.ld-pista-numbers dd{margin:2px 0 0;font-size:16px;font-weight:600;font-variant-numeric:tabular-nums}.ld-sort{border:0;padding:3px 0;background:transparent;color:var(--ld-muted);font:inherit;text-align:inherit;white-space:normal;line-height:1.4;width:100%;display:inline-flex;align-items:center;justify-content:inherit;gap:5px}.ld-num .ld-sort{justify-content:flex-end}.ld-sort [data-sort-icon]{font-size:12px;flex-shrink:0}.ld-sort:hover{color:var(--ld-fg)}.ld-table th[aria-sort=ascending] .ld-sort,.ld-table th[aria-sort=descending] .ld-sort{color:var(--ld-accent)}
@media(max-width:1100px){.ld-context-grid{grid-template-columns:1fr}.ld-pista-cards{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:720px){.ld-pista-cards{grid-template-columns:1fr}.ld-pista-numbers{grid-template-columns:repeat(4,minmax(0,1fr))}.ld-monthly{height:244px}}
@media(max-width:480px){.ld-filters .ld-clear{grid-column:1/-1}.ld-table thead{display:table-header-group}.ld-table thead tr{display:flex;flex-wrap:wrap;padding:0;background:transparent;gap:7px;margin:8px 0 12px}.ld-table th,.ld-table th:first-child{display:block;width:auto!important;border:1px solid var(--ld-line);border-radius:6px;padding:3px 7px!important;max-width:100%;font-size:10px}.ld-num .ld-sort{justify-content:flex-start}.ld-pista-numbers{grid-template-columns:repeat(2,minmax(0,1fr))}.ld-table tbody tr{display:grid}.ld-monthly{height:244px}}

.ld-root{--ld-rise:#e74f70;--ld-fall:#21ae8e;--ld-motion:650ms;position:relative}.ld-root[data-theme=light]{--ld-rise:#b32646;--ld-fall:#08775c}.ld-road{position:relative;height:22px;margin:12px 0 0;overflow:hidden;border-block:1px solid var(--ld-line);background:var(--ld-soft);pointer-events:none}.ld-road:before{content:"""";position:absolute;inset:10px 0 auto;height:1px;background:repeating-linear-gradient(90deg,var(--ld-muted) 0 16px,transparent 16px 30px);opacity:.45}.ld-road i{position:absolute;top:3px;width:18px;height:6px;border-radius:3px;background:var(--ld-accent);animation:ld-drive 12s linear 2 both;left:-25px}.ld-road i:nth-child(2){top:14px;animation-delay:2s;animation-direction:reverse;background:var(--ld-amber)}.ld-road i:nth-child(3){animation-delay:5s}.ld-ticker-values{overflow:hidden;min-width:0;flex:1;height:24px;position:relative;display:block!important}.ld-ticker-track{display:flex;align-items:center;gap:24px;width:max-content;animation:ld-ticker-scroll 20s linear 2 both;white-space:nowrap}.ld-ticker-track span{width:auto!important;display:inline!important;border:0!important;padding:0!important;font-weight:600;color:var(--ld-fg)}.ld-ticker:hover .ld-ticker-track,.ld-ticker:focus-within .ld-ticker-track{animation-play-state:paused}.ld-bar{transform-box:fill-box;transform-origin:center bottom;animation:ld-grow var(--ld-motion) ease-out both}.ld-curve{animation:ld-reveal var(--ld-motion) ease-out both}.ld-rank .ld-track i{transform-origin:left;animation:ld-grow-x var(--ld-motion) ease-out both}.ld-kpi{transition:transform .16s ease,box-shadow .16s ease}.ld-kpi:hover{transform:translateY(-2px);box-shadow:0 5px 15px #0002}.ld-bar:hover,.ld-line-point:hover{filter:brightness(1.2)}.ld-variation{display:block;font-size:10px;margin-top:7px;line-height:1.5;color:var(--ld-muted)}.ld-variation[data-direction=bad]{color:var(--ld-rise);animation:ld-pulse .7s ease-in-out 2}.ld-variation[data-direction=good]{color:var(--ld-fall)}.ld-tooltip{pointer-events:none}
@keyframes ld-drive{from{left:-25px}to{left:calc(100% + 25px)}}@keyframes ld-ticker-scroll{0%,10%,100%{transform:translateX(0)}45%,80%{transform:translateX(var(--ld-ticker-shift,0px))}}@keyframes ld-grow{from{transform:scaleY(0)}to{transform:scaleY(1)}}@keyframes ld-grow-x{from{transform:scaleX(0)}to{transform:scaleX(1)}}@keyframes ld-reveal{from{opacity:0}to{opacity:1}}@keyframes ld-pulse{50%{opacity:.65}}
@media(max-width:720px){.ld-ticker-values{flex:auto;width:100%}.ld-ticker{min-height:58px}}@media(prefers-reduced-motion:reduce){.ld-root *{animation:none!important;transition:none!important}.ld-road i{left:25%}.ld-road i:nth-child(2){left:55%}.ld-road i:nth-child(3){left:80%}}

.ld-root{--ld-spark:#64b9c1}.ld-root[data-theme=light]{--ld-spark:#087d83}.ld-kpi{padding-bottom:12px}.ld-sparkline{display:block;width:80%;height:26px;margin:4px 0 0;overflow:visible;pointer-events:none}.ld-spark-line{fill:none;stroke:var(--ld-spark);stroke-width:1.7;vector-effect:non-scaling-stroke;stroke-linecap:round;stroke-linejoin:round}.ld-spark-end{fill:var(--ld-spark);stroke:var(--ld-panel);stroke-width:1;vector-effect:non-scaling-stroke}.ld-spark-area{stroke:none}.ld-kpi .ld-variation{margin-top:3px}

.ld-filter-popup{position:fixed;z-index:10000;background:var(--ld-panel);color:var(--ld-fg);border:1px solid var(--ld-line);box-shadow:0 12px 40px #0005;border-radius:12px;padding:12px;max-height:340px;overflow:auto}.ld-popup-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.ld-popup-head button,.ld-filter-popup>button{background:var(--ld-soft);color:var(--ld-fg);border:1px solid var(--ld-line);border-radius:6px;padding:5px 9px}.ld-filter-popup input[type=search]{width:100%;border:1px solid var(--ld-line);border-radius:6px;background:var(--ld-bg);color:var(--ld-fg);padding:9px;font:inherit}.ld-filter-choices{max-height:200px;overflow:auto;margin:8px 0}.ld-filter-choices summary{cursor:pointer;font-weight:600;padding:7px}.ld-choice{display:flex;align-items:center;gap:9px;padding:7px 4px;font-size:12px;cursor:pointer}.ld-choice input{accent-color:var(--ld-accent);width:16px;height:16px;flex-shrink:0}.ld-choice-children{margin-left:18px}.ld-select{text-align:left;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;cursor:pointer}.ld-bar[aria-pressed=true]{opacity:1;stroke:var(--ld-fg);stroke-width:1.5}.ld-line-point[aria-pressed=true]{r:4}.ld-decision{border-top:1px solid var(--ld-line);padding-top:12px;margin-top:12px;font-size:12px}.ld-decision strong{display:block;margin-bottom:5px}.ld-decision small{display:block;color:var(--ld-muted);font-size:10px;margin-top:6px}.ld-trecho-link{background:none;border:0;color:var(--ld-accent);text-align:left;padding:0;cursor:pointer;font:inherit;text-decoration:underline;text-underline-offset:3px}.ld-readout [data-investigate]{margin-top:12px}.ld-root input:focus-visible,.ld-root summary:focus-visible{outline:2px solid var(--ld-accent);outline-offset:2px}
.ld-filter-popup{display:flex;flex-direction:column;overflow:hidden;max-height:min(340px,calc(100vh - 16px))}.ld-filter-popup>input,.ld-popup-head,.ld-filter-popup>button{flex-shrink:0}.ld-filter-choices{flex:1;min-height:0}.ld-filter-choices summary::before{content:""▸"";display:inline-block;margin-right:7px;color:var(--ld-accent)}.ld-filter-choices details[open]>summary::before{content:""▾""}.ld-select::after{content:""⌄"";float:right;margin-left:5px;color:var(--ld-muted)}.ld-curve{pointer-events:none}

.ld-focus-bar{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin:4px 0 5px}.ld-focus-bar>span{font-size:11px;color:var(--ld-muted);margin-right:5px}.ld-focus-bar button{border:1px solid var(--ld-line);border-radius:18px;background:var(--ld-panel);color:var(--ld-muted);padding:6px 10px;font:inherit;font-size:11px;cursor:pointer}.ld-focus-bar button[aria-pressed=true]{background:var(--ld-accent-soft);border-color:var(--ld-accent);color:var(--ld-fg)}.ld-focus-note{margin-bottom:12px!important}
</style><script type=""application/json"" class=""ld-data"">"
VAR _Fim = "</script><header class=""ld-head"">
  <div><div class=""ld-eyebrow""><span class=""ld-mark"" aria-hidden=""true""><i></i><i></i></span>Observatório viário · Ceará</div><h1 class=""ld-title"">Onde concentrar a prevenção?</h1><p class=""ld-subtitle"">PRF · BR-116 e BR-222 · <span data-period></span></p></div>
  <div class=""ld-tools""><button type=""button"" class=""ld-theme"" data-theme-toggle data-hc-suppress=""filter"" aria-label=""Alternar modo claro e escuro"">Modo claro ↗</button><p class=""ld-updated"" data-updated></p></div>
</header>
<div class=""ld-road"" aria-hidden=""true""><i></i><i></i><i></i></div><div class=""ld-rule""></div>
<section class=""ld-filters"" aria-label=""Filtros internos do painel"" data-hc-suppress=""filter"">
  <div class=""ld-field""><span>PERÍODO</span><button type=""button"" class=""ld-select"" data-picker=""mes"" aria-expanded=""false"" aria-haspopup=""dialog"" data-hc-suppress=""filter""></button></div>
  <div class=""ld-field""><span>MUNICÍPIO</span><button type=""button"" class=""ld-select"" data-picker=""municipio"" aria-expanded=""false"" aria-haspopup=""dialog"" data-hc-suppress=""filter""></button></div>
  <div class=""ld-field""><span>TIPO DE ACIDENTE</span><button type=""button"" class=""ld-select"" data-picker=""tipo"" aria-expanded=""false"" aria-haspopup=""dialog"" data-hc-suppress=""filter""></button></div>
  <div class=""ld-field""><span>RODOVIA / TRECHO</span><button type=""button"" class=""ld-select"" data-picker=""rodovia"" aria-expanded=""false"" aria-haspopup=""dialog"" data-hc-suppress=""filter""></button></div>
  <div class=""ld-field""><span>FASE DO DIA</span><button type=""button"" class=""ld-select"" data-picker=""fase"" aria-expanded=""false"" aria-haspopup=""dialog"" data-hc-suppress=""filter""></button></div>
  <div class=""ld-field""><span>CAUSA REGISTRADA</span><button type=""button"" class=""ld-select"" data-picker=""causa"" aria-expanded=""false"" aria-haspopup=""dialog"" data-hc-suppress=""filter""></button></div>
  <div class=""ld-field""><span>TIPO DE PISTA</span><button type=""button"" class=""ld-select"" data-picker=""pista"" aria-expanded=""false"" aria-haspopup=""dialog"" data-hc-suppress=""filter""></button></div>
  <button type=""button"" class=""ld-clear"" data-clear>Limpar filtros</button>
</section>
<div class=""ld-ticker"" tabindex=""0"" aria-label=""Tipos de acidente mais registrados no recorte""><span class=""ld-ticker-label"">EM FOCO</span><div class=""ld-ticker-values"" data-ticker></div></div>
<p class=""ld-selection"" data-selection aria-live=""polite""></p>
<section class=""ld-kpis"" aria-label=""Indicadores do recorte"" data-kpis></section>
<section class=""ld-empty"" data-empty hidden><h2>Nenhuma ocorrência neste recorte</h2><p>Combine outros filtros ou use “Limpar filtros”. Os filtros do relatório permanecem aplicados.</p></section>
<div data-analysis>
<div class=""ld-focus-bar"" role=""group"" aria-label=""Foco dos trechos"" data-hc-suppress=""filter""><span>Foco dos trechos</span><button type=""button"" data-focus=""volume"" aria-pressed=""true"">Mais ocorrências</button><button type=""button"" data-focus=""high"" aria-pressed=""false"">Maior % grave/fatal</button><button type=""button"" data-focus=""low"" aria-pressed=""false"">Menor % grave/fatal</button></div><p class=""ld-small-note ld-focus-note"" data-focus-note></p>
  <div class=""ld-main-grid"">
    <section class=""ld-panel""><div class=""ld-panel-header""><div><h2>Volume e gravidade ao longo do tempo</h2><p class=""ld-panel-desc"">Clique para selecionar · Ctrl+clique soma ou remove meses. Gráfico mantém o período de referência.</p></div><div class=""ld-legend""><span><i class=""ld-dot""></i>Acidentes</span><span><i class=""ld-dot ld-line-dot""></i>Graves ou fatais</span><span><i class=""ld-dot ld-median-dot""></i>Mediana mensal</span></div></div><div data-monthly></div><p class=""ld-chart-note"" data-monthly-note></p></section>
    <section class=""ld-panel ld-readout"" aria-label=""Leitura executiva""><h2>Onde agir e por quê</h2><div data-readout></div></section>
  </div>
  <div class=""ld-bottom-grid"">
    <section class=""ld-panel""><div class=""ld-panel-header""><div><h2>Municípios com mais registros</h2><p class=""ld-panel-desc"">Selecione uma barra para explorar o município</p></div></div><div class=""ld-rank-list"" data-municipios></div></section>
    <section class=""ld-panel""><div class=""ld-panel-header""><div><h2>Tipos de acidente em destaque</h2><p class=""ld-panel-desc"">Volume no recorte atual</p></div></div><div class=""ld-rank-list"" data-tipos></div></section>
    <section class=""ld-panel""><div class=""ld-panel-header""><div><h2>Causas registradas em destaque</h2><p class=""ld-panel-desc"">Categoria registrada pela PRF · selecione para explorar</p></div></div><div class=""ld-rank-list"" data-causas></div><p class=""ld-small-note"">A frequência de uma causa registrada não comprova causalidade.</p></section>
  </div>
  <div class=""ld-context-grid"">
    <section class=""ld-panel""><div class=""ld-panel-header""><div><h2>Gravidade por rodovia</h2><p class=""ld-panel-desc"">Maior para menor proporção · observe também a quantidade de registros</p></div></div><div class=""ld-rank-list"" data-rodovias></div><p class=""ld-small-note"">Comparação descritiva, sem ajuste pelo fluxo de veículos.</p></section>
    <section class=""ld-panel""><div class=""ld-panel-header""><div><h2>Consequências por tipo de pista</h2><p class=""ld-panel-desc"">As marcações descrevem vítimas registradas, não faixas de risco.</p></div></div><p class=""ld-outcome-alert"" data-pista-alert role=""status""></p><div class=""ld-pista-cards"" data-pistas></div><p class=""ld-small-note"">Limites de risco não definidos na fonte. Sem classificação de saudável, atenção ou crítico.</p></section>
  </div>
  <section class=""ld-panel ld-table-panel""><div class=""ld-panel-header""><div><h2>Compare os trechos em foco</h2><p class=""ld-panel-desc"">Até dez trechos conforme o foco escolhido · clique no trecho para investigar; cabeçalhos ordenam</p></div><span class=""ld-panel-desc"" data-table-total></span></div>
  <table class=""ld-table""><thead data-hc-suppress=""filter""><tr><th data-sort-header=""trecho"" aria-sort=""none""><button type=""button"" class=""ld-sort"" data-sort=""trecho"">Trecho <span data-sort-icon>↕</span></button></th><th class=""ld-num"" data-sort-header=""acidentes"" aria-sort=""descending""><button type=""button"" class=""ld-sort"" data-sort=""acidentes"">Acidentes <span data-sort-icon>↓</span></button></th><th class=""ld-num"" data-sort-header=""graves"" aria-sort=""none""><button type=""button"" class=""ld-sort"" data-sort=""graves"">Graves/fatais <span data-sort-icon>↕</span></button></th><th class=""ld-num"" data-sort-header=""percentualGrave"" aria-sort=""none""><button type=""button"" class=""ld-sort"" data-sort=""percentualGrave"">% graves/fatais <span data-sort-icon>↕</span></button></th><th class=""ld-num"" data-sort-header=""feridos"" aria-sort=""none""><button type=""button"" class=""ld-sort"" data-sort=""feridos"">Feridos <span data-sort-icon>↕</span></button></th><th class=""ld-num"" data-sort-header=""mortes"" aria-sort=""none""><button type=""button"" class=""ld-sort"" data-sort=""mortes"">Mortes <span data-sort-icon>↕</span></button></th></tr></thead><tbody data-trechos></tbody></table><div class=""ld-table-meta""><span>Intervalos de 10 km: limite inferior inclusivo; superior exclusivo.</span><span data-quality></span></div></section>
</div>
<footer class=""ld-footer""><p>Fonte: PRF · registros por ocorrência · 2021–2025. Vítimas são pessoas. O painel apoia a priorização de vistorias; intervenções exigem avaliação técnica.</p><span class=""ld-status"" data-status>Dados carregados</span></footer>
<div class=""ld-filter-popup"" data-popup hidden data-hc-suppress=""filter""></div>
<div class=""ld-tooltip"" role=""tooltip"" hidden></div>
<script>(function(){
  'use strict';
  const root=document.getElementById('ld-prf-root');
  if(!root)return;
  const esc=v=>String(v??'').replace(/[&<>""']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','""':'&quot;',""'"":'&#39;'}[c]));
  const integer=new Intl.NumberFormat('pt-BR',{maximumFractionDigits:0});
  const decimal=new Intl.NumberFormat('pt-BR',{minimumFractionDigits:1,maximumFractionDigits:1});
  const n=v=>integer.format(v||0), pct=v=>v==null?'—':decimal.format(v*100)+'%';
  const el=s=>root.querySelector(s);
  const monthLabel=s=>{const [y,m]=s.split('-');return new Date(Number(y),Number(m)-1,1).toLocaleDateString('pt-BR',{month:'short',year:'numeric'}).replace('.','');};
  try{
    const data=JSON.parse(el('.ld-data').textContent);
    if(!data.meta?.baseCompleta||!Array.isArray(data.baseInterativa))throw Error('Contrato de dados incompleto.');
    const toMap=a=>new Map((a||[]).map(x=>[x.k,x]));
    const loc=toMap(data.localidades),trecho=toMap(data.trechos),cond=toMap(data.condicoes),tipos=toMap(data.tipos),causas=toMap(data.causas),gravidades=toMap(data.gravidades);
    const base=data.baseInterativa.map(r=>{
      const l=loc.get(r.l),t=trecho.get(r.t),v=cond.get(r.v),c=tipos.get(r.c),ca=causas.get(r.ca),g=gravidades.get(r.g);
      if(!l||!t||!v||!c||!ca||!g)throw Error('Referência de dados ausente.');
      return {...r,mes:r.d.slice(0,7),municipio:l.municipio,uf:l.uf,rodovia:t.rodovia,trecho:t.rotulo,trechoChave:t.chave,inicio:t.inicio,tipo:c.rotulo,causa:ca.rotulo,gravidade:g.rotulo,fase:v.fase,pista:v.pista,clima:v.clima,grave:r.fg>0||r.m>0,noite:v.fase==='Plena Noite'};
    });
    if(base.length!==(data.meta.linhas??0)||new Set(base.map(r=>r.id)).size!==base.length)throw Error('Base incompleta ou IDs repetidos.');
    const keys=['mes','municipio','tipo','rodovia','fase','causa','pista','trechoChave'];
    const previous=window.__ldPRFState||{};
    const sortKeys=['trecho','acidentes','graves','percentualGrave','feridos','mortes'];
    const state={focus:['volume','high','low'].includes(previous.focus)?previous.focus:'volume',theme:previous.theme==='light'?'light':'dark',filters:Object.fromEntries(keys.map(k=>[k,Array.isArray(previous.filters?.[k])?previous.filters[k]:(previous.filters?.[k]?[previous.filters[k]]:[])])),sort:sortKeys.includes(previous.sort?.key)?{key:previous.sort.key,dir:previous.sort.dir==='asc'?'asc':'desc'}:{key:'acidentes',dir:'desc'}};
    const save=()=>{window.__ldPRFState={focus:state.focus,theme:state.theme,filters:{...state.filters},sort:{...state.sort}};};
    const groups=(rows,key)=>{const m=new Map();for(const r of rows){const k=r[key];if(!m.has(k))m.set(k,[]);m.get(k).push(r);}return m;};
    const basic=rows=>({acidentes:rows.length,graves:rows.filter(r=>r.grave).length,feridos:rows.reduce((s,r)=>s+r.f,0),feridosGraves:rows.reduce((s,r)=>s+r.fg,0),mortes:rows.reduce((s,r)=>s+r.m,0),plenaNoite:rows.filter(r=>r.noite).length,comAlertas:rows.filter(r=>r.q).length,pessoasDivergentes:rows.filter(r=>r.qp).length,classificacoesDivergentes:rows.filter(r=>r.qc).length,classificacoesAusentes:rows.filter(r=>r.qa).length});
    const ranked=(rows,key)=>[...groups(rows,key)].map(([name,rs])=>{const a=basic(rs);return {name,...a,percentualGrave:a.graves/a.acidentes};});
    const byVolume=(x,y)=>y.acidentes-x.acidentes||x.name.localeCompare(y.name,'pt-BR');
    const byConsequences=(x,y)=>y.graves-x.graves||y.acidentes-x.acidentes||x.name.localeCompare(y.name,'pt-BR');
    const median=values=>{const v=values.filter(x=>typeof x==='number'&&Number.isFinite(x)).sort((a,b)=>a-b);const mid=Math.floor(v.length/2);return !v.length?null:v.length%2?v[mid]:(v[mid-1]+v[mid])/2;};
    const aggregate=rows=>{
      const a=basic(rows);a.percentualGrave=a.acidentes?a.graves/a.acidentes:null;a.percentualNoite=a.acidentes?a.plenaNoite/a.acidentes:null;
      a.trechos=[...groups(rows,'trechoChave')].map(([k,rs])=>({k,rotulo:rs[0].trecho,rodovia:rs[0].rodovia,inicio:rs[0].inicio,...basic(rs)})).sort((x,y)=>y.acidentes-x.acidentes||x.k.localeCompare(y.k));
      a.concentracaoTop5=a.acidentes?a.trechos.slice(0,5).reduce((s,t)=>s+t.acidentes,0)/a.acidentes:null;
      return a;
    };
    const matches=(r,k)=>!state.filters[k].length||state.filters[k].includes(r[k]);
    const filtered=(except=null)=>base.filter(r=>keys.every(k=>k===except||matches(r,k)));
    const typeCategory=t=>/^Colisão|^Engavetamento/i.tes" &
"t(t)?'Colisões e engavetamentos':/^Atropelamento/i.test(t)?'Atropelamentos':/^(Saída de leito carroçável|Capotamento|Tombamento)$/i.test(t)?'Saída, capotamento e tombamento':'Outros tipos';
    const names={mes:'Período',municipio:'Município',tipo:'Tipo de acidente',rodovia:'Rodovia / trecho',fase:'Fase do dia',causa:'Causa registrada',pista:'Tipo de pista'};
    const norm=s=>String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
    let opened=null,query='';
    const options=()=>{root.querySelectorAll('[data-picker]').forEach(b=>{const k=b.dataset.picker,vs=k==='rodovia'?[...state.filters.rodovia,...state.filters.trechoChave]:state.filters[k];b.textContent=!vs.length?'Todos':vs.length===1?(k==='mes'?monthLabel(vs[0]):k==='rodovia'&&state.filters.trechoChave.length?base.find(r=>r.trechoChave===vs[0])?.trecho||vs[0]:vs[0]):vs.length+' selecionados';b.setAttribute('aria-label',names[k]+': '+b.textContent);});};
    const setFilter=(k,v)=>{if(!keys.includes(k))return;state.filters[k]=Array.isArray(v)?[...new Set(v)]:(v?[v]:[]);options();save();render();};
    const toggleFilter=(k,v,add)=>{setFilter(k,add?(state.filters[k].includes(v)?state.filters[k].filter(x=>x!==v):[...state.filters[k],v]):[v]);};
    const closePopup=()=>{el('[data-popup]').hidden=true;root.querySelectorAll('[data-picker]').forEach(b=>b.setAttribute('aria-expanded','false'));opened=null;};
    function drawChoices(){
      const k=opened;if(!k)return;const host=el('[data-filter-choices]'),q=norm(query);const found=text=>q.split(/\s+/).every(w=>norm(text).includes(w));
      const check=(key,value,label,checked,group=false,mixed=false)=>'<label class=""ld-choice""><input type=""checkbox"" data-choice=""'+key+'"" value=""'+esc(value)+'"" '+(group?'data-group=""true"" ':'')+(mixed?'data-mixed=""true"" ':'')+(checked?'checked ':'')+'/><span>'+esc(label)+'</span></label>';
      let html='';
      if(k==='tipo'){const categories=new Map();for(const t of [...new Set(base.map(r=>r.tipo))].sort()){const c=typeCategory(t);if(!categories.has(c))categories.set(c,[]);categories.get(c).push(t);}for(const [c,ts]of categories){const visible=ts.filter(t=>found(c+' '+t));if(!visible.length)continue;const count=ts.filter(t=>state.filters.tipo.includes(t)).length;html+='<details '+(q||count?'open':'')+'><summary>'+esc(c)+'</summary>'+check('tipo',c,'Selecionar grupo',count===ts.length,true,count>0&&count<ts.length)+'<div class=""ld-choice-children"">'+visible.map(t=>check('tipo',t,t,state.filters.tipo.includes(t))).join('')+'</div></details>';}}else if(k==='mes'||k==='rodovia'){
        const groupsMap=new Map();const values=k==='mes'?[...new Set((data.seriesMensais||[]).map(r=>r.mes))].sort():[...new Map(base.map(r=>[r.trechoChave,r])).values()].sort((a,b)=>a.rodovia.localeCompare(b.rodovia)||a.inicio-b.inicio);
        for(const v of values){const group=k==='mes'?v.slice(0,4):v.rodovia;if(!groupsMap.has(group))groupsMap.set(group,[]);groupsMap.get(group).push(v);}
        for(const[g,vs]of groupsMap){const visible=vs.filter(v=>found(g+' '+(k==='mes'?monthLabel(v):v.trecho)));if(!visible.length)continue;const leafKey=k==='mes'?'mes':'trechoChave';const selected=v=>state.filters[leafKey].includes(k==='mes'?v:v.trechoChave)||(k==='rodovia'&&state.filters.rodovia.includes(g));const count=vs.filter(selected).length;html+='<details '+(q||count?'open':'')+'><summary>'+esc(g)+'</summary>'+check(k,g,'Selecionar '+g,count===vs.length,true,count>0&&count<vs.length)+'<div class=""ld-choice-children"">'+visible.map(v=>check(leafKey,k==='mes'?v:v.trechoChave,k==='mes'?monthLabel(v):v.trecho,selected(v))).join('')+'</div></details>';}
      }else html=[...new Set(base.map(r=>r[k]))].sort((a,b)=>a.localeCompare(b,'pt-BR')).filter(v=>found(v)).map(v=>check(k,v,v,state.filters[k].includes(v))).join('');
      host.innerHTML=html||'<p class=""ld-small-note"">Nenhuma opção encontrada.</p>';host.querySelectorAll('[data-mixed]').forEach(e=>e.indeterminate=true);
    }
    function openPopup(button){if(opened===button.dataset.picker){closePopup();return;}closePopup();opened=button.dataset.picker;query='';const pop=el('[data-popup]');pop.innerHTML='<div class=""ld-popup-head""><strong>'+names[opened]+'</strong><button type=""button"" data-popup-close aria-label=""Fechar filtro"">×</button></div><input type=""search"" data-filter-search aria-label=""Pesquisar opções"" placeholder=""Pesquisar…""/><div class=""ld-filter-choices"" data-filter-choices></div><button type=""button"" data-filter-reset>Limpar este filtro</button>';pop.hidden=false;button.setAttribute('aria-expanded','true');const b=button.getBoundingClientRect();pop.style.width=Math.min(340,window.innerWidth-16)+'px';pop.style.left=Math.max(8,Math.min(b.left,window.innerWidth-Math.min(340,window.innerWidth-16)-8))+'px';pop.style.top=Math.max(8,Math.min(b.bottom+5,window.innerHeight-350))+'px';drawChoices();el('[data-filter-search]').focus();}
    const periods=(rows,selected=true)=>{
      const observed=groups(rows,'mes');
      const months=(data.seriesMensais||[]).map(x=>x.mes).filter(m=>!selected||!state.filters.mes.length||state.filters.mes.includes(m));
      return months.map(m=>{const a=basic(observed.get(m)||[]);return {mes:m,...a,percentualGrave:a.acidentes?a.graves/a.acidentes:null};});
    };
    let lastRows=[],lastStats=null,lastSeries=[],lastMedian=null,lastExecutive=null,lastRoads=[],lastPistas=[];
    const focusTrechos=ts=>[...ts].sort((a,b)=>(state.focus==='volume'?b.acidentes-a.acidentes:state.focus==='high'?b.graves/b.acidentes-a.graves/a.acidentes:a.graves/a.acidentes-b.graves/b.acidentes)||b.acidentes-a.acidentes||a.k.localeCompare(b.k));
    function renderTable(){
      const selection=focusTrechos(lastStats?.trechos||[]).slice(0,10);
      const compare=new Intl.Collator('pt-BR',{numeric:true,sensitivity:'base'});
      const value=t=>state.sort.key==='trecho'?t.rotulo:state.sort.key==='percentualGrave'?t.graves/t.acidentes:t[state.sort.key];
      const sorted=[...selection].sort((a,b)=>{const av=value(a),bv=value(b),order=typeof av==='string'?compare.compare(av,bv):av-bv;return (state.sort.dir==='asc'?order:-order)||compare.compare(a.k,b.k);});
      el('[data-trechos]').innerHTML=sorted.map(t=>'<tr data-row-key=""'+esc(t.k)+'""><td data-value=""'+esc(t.rotulo)+'""><button type=""button"" class=""ld-trecho-name ld-trecho-link"" data-investigate=""'+esc(t.k)+'"">'+esc(t.rodovia)+' · km '+n(t.inicio)+'–'+n(t.inicio+10)+'</button><span class=""ld-trecho-sub"">Ceará · intervalo de 10 km</span></td><td class=""ld-num"" data-label=""Acidentes"" data-value=""'+t.acidentes+'"">'+n(t.acidentes)+'</td><td class=""ld-num"" data-label=""Graves/fatais"" data-value=""'+t.graves+'"">'+n(t.graves)+'</td><td class=""ld-num ld-severity"" data-label=""% graves/fatais"" data-value=""'+t.graves/t.acidentes+'"">'+pct(t.graves/t.acidentes)+'</td><td class=""ld-num"" data-label=""Feridos"" data-value=""'+t.feridos+'"">'+n(t.feridos)+'</td><td class=""ld-num"" data-label=""Mortes"" data-value=""'+t.mortes+'"">'+n(t.mortes)+'</td></tr>').join('');
      root.querySelectorAll('[data-sort-header]').forEach(th=>{const active=th.dataset.sortHeader===state.sort.key;th.setAttribute('aria-sort',active?(state.sort.dir==='asc'?'ascending':'descending'):'none');th.querySelector('[data-sort-icon]').textContent=active?(state.sort.dir==='asc'?'↑':'↓'):'↕';th.querySelector('button').setAttribute('aria-label','Ordenar por '+th.querySelector('button').textContent.replace(/[↑↓↕]/g,'').trim()+(active?', ordem '+(state.sort.dir==='asc'?'crescente':'decrescente'):', sem ordenação ativa'));});
    }
    function drawMonthly(){
      const host=el('[data-monthly]'),series=lastSeries;
      if(!lastRows.length||!series.length){host.innerHTML='<div class=""ld-chart-empty"">Sem dados no período selecionado.</div>';return;}
      const w=Math.max(230,Math.floor(host.clientWidth)),h=244,left=36,right=38,top=35,bottom=35,pw=w-left-right,ph=h-top-bottom;
      const raw=Math.max(1,...series.map(s=>s.acidentes)),power=Math.pow(10,Math.floor(Math.log10(raw/4))),unit=[1,2,5,10].find(x=>x*power>=raw/4)*power,yMax=Math.max(unit,Math.ceil(raw/unit)*unit);
      const x=i=>left+(i+.5)*pw/series.length,y=v=>top+ph-v/yMax*ph,yp=v=>top+ph-v*ph;
      let grid='',bars='',labels='',points='',path='',active=false;
      for(let v=0;v<=yMax+unit/10;v+=unit){const yy=y(v);grid+='<line class=""ld-grid-line"" x1=""'+left+'"" x2=""'+(w-right)+'"" y1=""'+yy+'"" y2=""'+yy+'""/><text x=""'+(left-7)+'"" y=""'+(yy+4)+'"" text-anchor=""end"">'+n(v)+'</text>';}
      [0,.5,1].forEach(v=>{grid+='<text x=""'+(w-right+7)+'"" y=""'+(yp(v)+4)+'"">'+Math.round(v*100)+'%</text>';});
      grid+='<text class=""ld-axis-title"" x=""'+left+'"" y=""13"">Acidentes (n)</text><text class=""ld-axis-title"" x=""'+(w-right)+'"" y=""13"" text-anchor=""end"">Graves/fatais (%)</text>';
      const tickEvery=Math.max(1,Math.ceil(series.length/Math.max(2,Math.floor(pw/85))));
      series.forEach((s,i)=>{
        const xx=x(i),yy=y(s.acidentes),bw=Math.max(1,Math.min(25,pw/series.length*.62));
        const delta=s.percentualGrave==null||lastStats.percentualGrave==null?null:s.percentualGrave-lastStats.percentualGrave;
        const comparison=delta==null?'Sem proporção calculável neste mês.':Math.abs(delta)<1e-12?'Igual à média ponderada do recorte.':decimal.format(Math.abs(delta)*100)+' p.p. '+(delta>0?'acima':'abaixo')+' da média ponderada do recorte.';
        const tip=monthLabel(s.mes)+'\n'+n(s.acidentes)+' acidentes\n'+n(s.graves)+' graves ou fatais · '+pct(s.percentualGrave)+'\n'+n(s.feridos)+' feridos · '+n(s.mortes)+' mortes\nMediana mensal: '+pct(lastMedian)+'\n'+comparison+'\n'+n(s.comAlertas)+' registros com alertas de qualidade';
        bars+='<rect class=""ld-bar"" x=""'+(xx-bw/2)+'"" y=""'+yy+'"" width=""'+bw+'"" height=""'+Math.max(0,top+ph-yy)+'"" aria-pressed=""'+state.filters.mes.includes(s.mes)+'"" data-month=""'+s.mes+'"" data-hc-suppress=""filter"" data-tip=""'+esc(tip)+'"" role=""button"" tabindex=""0"" aria-label=""'+esc(tip+' · Selecionar; Ctrl combina meses')+'""/>';
        if(s.percentualGrave!=null){path+=(active?'L':'M')+xx+','+yp(s.percentualGrave)+' ';active=true;points+='<circle class=""ld-line-point"" cx=""'+xx+'"" cy=""'+yp(s.percentualGrave)+'"" r=""'+(series.length>24?1.7:3)+'"" aria-pressed=""'+state.filters.mes.includes(s.mes)+'"" data-month=""'+s.mes+'"" data-hc-suppress=""filter"" data-tip=""'+esc(tip)+'"" role=""button"" tabindex=""0"" aria-label=""'+esc(tip+' · Selecionar; Ctrl combina meses')+'""/>';}else active=false;
        if(i%tickEvery===0||series.length===1){const lab=new Date(s.mes+'-02T12:00:00').toLocaleDateString('pt-BR',{month:'short',year:'2-digit'}).replace('.','');labels+='<text x=""'+xx+'"" y=""'+(h-8)+'"" text-anchor=""middle"">'+esc(lab)+'</text>';}
      });
      const medianLine=lastMedian==null?'':'<line class=""ld-median-line"" x1=""'+left+'"" x2=""'+(w-right)+'"" y1=""'+yp(lastMedian)+'"" y2=""'+yp(lastMedian)+'"" aria-label=""Mediana mensal '+pct(lastMedian)+'""/>';
      host.innerHTML='<svg class=""ld-monthly"" viewBox=""0 0 '+w+' '+h+'"" role=""img"" aria-label=""Ocorrências mensais, percentual grave/fatal e mediana mensal. Eixos nomeados de quantidade e percentual."">'+grid+bars+medianLine+'<path class=""ld-curve"" d=""'+path+'""/>'+points+labels+'</svg>';
      const months=periods(lastRows).filter(s=>s.percentualGrave!=null).length;
      el('[data-monthly-note]').textContent='Mediana dos meses do recorte: '+pct(lastMedian)+' · média ponderada do recorte: '+pct(lastStats.percentualGrave)+(months===1?' · Um único mês com ocorrências; sem comparação temporal.':' · '+n(months)+' meses com ocorrências.');
    }
    let lastSparkSeries=[];
    function sparkline(key){
      const field={acidentes:'acidentes',graves:'percentualGrave',mortes:'mortes',feridos:'feridos',noite:'percentualNoite',concentracao:'concentracaoTop5'}[key];
      const values=lastSparkSeries.map(s=>s[field]),valid=values.filter(v=>v!=null&&Number.isFinite(v));
      const lo=valid.length?Math.min(...valid):0,hi=valid.length?Math.max(...valid):0;
      const x=i=>values.length===1?80" &
":4+i*152/(values.length-1),y=v=>hi===lo?13:22-(v-lo)/(hi-lo)*18;
      const segments=[];let segment=[];
      values.forEach((v,i)=>{if(v==null||!Number.isFinite(v)){if(segment.length)segments.push(segment);segment=[];}else segment.push({x:x(i),y:y(v)});});if(segment.length)segments.push(segment);
      const curve=pts=>pts.map((p,i)=>{if(!i)return 'M'+p.x+','+p.y;const a=pts[i-1],d=(p.x-a.x)/3;return 'C'+(a.x+d)+','+a.y+' '+(p.x-d)+','+p.y+' '+p.x+','+p.y;}).join(' ');
      const id='ld-spark-fill-'+key;
      const line=segments.map(curve).join(' '),area=segments.filter(p=>p.length>1).map(p=>curve(p)+' L'+p.at(-1).x+',25 L'+p[0].x+',25 Z').join(' ');
      const final=values.at(-1),dot=final==null||!Number.isFinite(final)?'':'<circle class=""ld-spark-end"" cx=""'+x(values.length-1)+'"" cy=""'+y(final)+'"" r=""2.2""/>';
      const label=lastSparkSeries.length?'Tendência mensal: '+monthLabel(lastSparkSeries[0].mes)+' a '+monthLabel(lastSparkSeries.at(-1).mes)+'. '+(valid.length===1?'Um único período válido.':''): 'Sem série disponível.';
      return '<svg class=""ld-sparkline"" viewBox=""0 0 160 26"" preserveAspectRatio=""none"" role=""img"" aria-label=""'+esc(label)+'""><defs><linearGradient id=""'+id+'"" x1=""0"" y1=""0"" x2=""0"" y2=""1""><stop offset=""0%"" stop-color=""var(--ld-spark)"" stop-opacity="".12""/><stop offset=""100%"" stop-color=""var(--ld-spark)"" stop-opacity=""0""/></linearGradient></defs><path class=""ld-spark-area"" fill=""url(#'+id+')"" d=""'+area+'""/><path class=""ld-spark-line"" d=""'+line+'""/>'+dot+'</svg>';
    }
    function render(){
      const rows=filtered(),a=aggregate(rows);lastRows=rows;lastStats=a;lastSeries=periods(rows);lastMedian=median(lastSeries.map(s=>s.percentualGrave));lastExecutive=null;lastRoads=[];lastPistas=[];
      root.dataset.theme=state.theme;
      el('[data-theme-toggle]').textContent=state.theme==='dark'?'Modo claro ↗':'Modo escuro ↗';
      el('[data-theme-toggle]').setAttribute('aria-pressed',String(state.theme==='light'));
      const history=base.filter(r=>keys.every(k=>k==='mes'||matches(r,k)));
      const end=state.filters.mes.length?[...state.filters.mes].sort().at(-1):[...new Set(history.map(r=>r.mes))].sort().at(-1);
      lastSeries=periods(history,false);
      const prior=end?new Date(Number(end.slice(0,4)),Number(end.slice(5))-2,1):null;
      const priorKey=prior?prior.getFullYear()+'-'+String(prior.getMonth()+1).padStart(2,'0'):'';
      const current=aggregate(history.filter(r=>r.mes===end)),previous=aggregate(history.filter(r=>r.mes===priorKey));
      const metricKeys={acidentes:'acidentes',graves:'percentualGrave',mortes:'mortes',feridos:'feridos',noite:'percentualNoite',concentracao:'concentracaoTop5'};
      const variation=key=>{const field=metricKeys[key],x=current[field],y=previous[field],ratio=['graves','noite','concentracao'].includes(key);if(!previous.acidentes||!current.acidentes||x==null||y==null||(!ratio&&!y))return '<span class=""ld-variation"">Comparação mensal indisponível</span>';const delta=ratio?(x-y)*100:(x-y)/y*100;const direction=key==='concentracao'?'neutral':delta>0?'bad':delta<0?'good':'neutral';return '<span class=""ld-variation"" data-direction=""'+direction+'"">'+(delta>0?'↑ +':delta<0?'↓ ':'= ')+decimal.format(delta)+(ratio?' p.p.':'%')+' · '+monthLabel(end)+' vs '+monthLabel(priorKey)+'</span>';};
      lastSparkSeries=periods(rows).slice(-12).map(s=>({mes:s.mes,...aggregate(rows.filter(r=>r.mes===s.mes))}));
      const cards=[
        ['acidentes','Acidentes registrados',n(a.acidentes),'Ocorrências distintas'],
        ['graves','Graves ou fatais',pct(a.percentualGrave),n(a.graves)+' ocorrências'],
        ['mortes','Mortes registradas',n(a.mortes),'Pessoas mortas na fonte'],
        ['feridos','Pessoas feridas',n(a.feridos),'Ferimentos leves ou graves'],
        ['noite','Em plena noite',pct(a.percentualNoite),n(a.plenaNoite)+' ocorrências'],
        ['concentracao','Nos 5 principais trechos',pct(a.concentracaoTop5),'Participação nos registros']
      ];
      el('[data-kpis]').innerHTML=cards.map(([key,label,value,detail])=>'<article class=""ld-kpi"" data-metric=""'+key+'""><span class=""ld-kpi-label"">'+label+'</span><strong class=""ld-kpi-value"">'+value+'</strong><span class=""ld-kpi-detail"">'+detail+'</span>'+sparkline(key)+variation(key)+'</article>').join('');
      const choices=keys.filter(k=>state.filters[k].length).map(k=>(names[k]||'Trecho')+': '+(state.filters[k].length>2?state.filters[k].length+' selecionados':state.filters[k].map(v=>k==='mes'?monthLabel(v):k==='trechoChave'?base.find(r=>r.trechoChave===v)?.trecho||v:v).join(', ')));
      const dates=rows.map(r=>r.d).sort();
      el('[data-period]').textContent=dates.length?(dates[0].slice(0,7)===dates[dates.length-1].slice(0,7)?monthLabel(dates[0].slice(0,7)):monthLabel(dates[0].slice(0,7))+' — '+monthLabel(dates[dates.length-1].slice(0,7))):'Recorte sem registros';
      el('[data-selection]').textContent=choices.length?'Recorte interno: '+choices.join(' · '):'Explorando todo o recorte recebido do relatório';
      el('[data-empty]').hidden=rows.length>0;el('[data-analysis]').hidden=!rows.length;
      el('.ld-tooltip').hidden=true;
      if(!rows.length){
        el('[data-ticker]').textContent='Sem ocorrências na combinação atual.';
        for(const s of ['[data-monthly]','[data-readout]','[data-municipios]','[data-tipos]','[data-pistas]','[data-trechos]','[data-causas]','[data-rodovias]'])el(s).innerHTML='';
        el('[data-monthly-note]').textContent='';el('[data-pista-alert]').textContent='';
        el('[data-quality]').textContent='';el('[data-table-total]').textContent='';
      }else{
        const municipality=ranked(rows,'municipio').sort(byVolume);
        const typeRanks=ranked(rows,'tipo').sort(byVolume);
        const causeRanks=ranked(rows,'causa').sort(byVolume);
        const roadRanks=ranked(rows,'rodovia').sort((x,y)=>y.percentualGrave-x.percentualGrave||y.acidentes-x.acidentes||x.name.localeCompare(y.name));
        const roadAttention=[...roadRanks].sort(byConsequences)[0],municipalityAttention=[...municipality].sort(byConsequences)[0];
        lastRoads=roadRanks;lastExecutive={rodovia:roadAttention,municipio:municipalityAttention,causa:causeRanks[0]};
        el('[data-ticker]').innerHTML='<div class=""ld-ticker-track"">'+typeRanks.slice(0,4).map((t,i)=>'<span>'+String(i+1).padStart(2,'0')+' · '+esc(t.name)+' — '+n(t.acidentes)+' ocorrências</span>').join('')+'</div>';
        const priority=focusTrechos(a.trechos)[0];
        const priorityShare=a.graves?priority.graves/a.graves:null;
        const priorityRate=priority.graves/priority.acidentes;
        const priorityLabel='dos acidentes deste trecho são graves/fatais';
        const target=rows.filter(r=>r.trechoChave===priority.k),context=filtered('fase').filter(r=>r.trechoChave===priority.k),night=aggregate(context.filter(r=>r.fase==='Plena Noite')),day=aggregate(context.filter(r=>r.fase==='Pleno dia'));
        const cause=ranked(target,'causa').sort(byVolume)[0],type=ranked(target,'tipo').sort(byConsequences)[0];
        const comparison=night.acidentes&&day.acidentes?'No mesmo trecho e período, plena noite: '+n(night.graves)+'/'+n(night.acidentes)+' graves/fatais ('+pct(night.percentualGrave)+'); pleno dia: '+n(day.graves)+'/'+n(day.acidentes)+' ('+pct(day.percentualGrave)+'). Diferença: '+decimal.format((night.percentualGrave-day.percentualGrave)*100)+' p.p.':'Não há ocorrências suficientes nas duas fases para comparar noite e pleno dia neste recorte.';
        const focus=night.acidentes&&day.acidentes?(night.percentualGrave>day.percentualGrave?' Observar especialmente as condições noturnas.':night.percentualGrave<day.percentualGrave?' A proporção diurna é maior neste recorte.':' As proporções são iguais neste recorte.') :'';
        const action=state.focus==='low'?'Usar este trecho como referência de comparação e investigar diferenças de tráfego, extensão e registro; menor proporção observada não comprova maior segurança.':/pedestre/i.test(type.name)?'Vistoriar travessias, acessos de pedestres e visibilidade.':/animal/i.test(type.name)?'Vistoriar pontos de entrada e presença de animais; revisar os registros com as equipes locais.':/traseira/i.test(type.name)?'Vistoriar aproximações, filas, sinalização e condições de visibilidade; avaliar atuação sobre distância de segurança.':/transversal|lateral/i.test(type.name)?'Vistoriar acessos, cruzamentos, conflitos de circulação e visibilidade.':'Vistoriar o local e revisar a dinâmica dos acidentes registrados antes de definir a intervenção.';
        const pavement=context.filter(r=>/buraco|defeito.*via|pavimento/i.test(r.causa)).length;
        el('[data-readout]').innerHTML='<p class=""ld-insight-number"">'+pct(priorityRate)+'</p><p class=""ld-insight-title"">'+priorityLabel+'</p><p class=""ld-insight-copy""><strong>'+esc(priority.rotulo)+'</strong>: '+n(priority.acidentes)+' ocorrências, '+n(priority.graves)+' graves/fatais e '+n(priority.mortes)+' mortes no recorte.</p><div class=""ld-decision""><strong>Comparação que orienta a vistoria</strong><p>'+comparison+'</p></div><div class=""ld-decision""><strong>O que os registros apontam</strong><p>Tipo com mais graves/fatais no trecho: '+esc(type.name)+' ('+n(type.graves)+' em '+n(type.acidentes)+' ocorrências). Causa mais registrada: '+esc(cause.name)+' ('+n(cause.acidentes)+').</p></div><div class=""ld-action""><strong>Ação a avaliar</strong>'+action+focus+'</div><button type=""button"" class=""ld-clear"" data-investigate=""'+esc(priority.k)+'"">Investigar este trecho</button>';

        function ranks(selector,list,key,metric='acidentes'){const maximum=metric==='percentualGrave'?1:list[0]?.acidentes||1;el(selector).innerHTML=list.slice(0,5).map(r=>'<button type=""button"" class=""ld-rank"" data-filter-kind=""'+key+'"" data-filter-value=""'+esc(r.name)+'"" data-hc-suppress=""filter"" data-tip=""'+esc(r.name+'\n'+n(r.acidentes)+' ocorrências · '+pct(r.acidentes/a.acidentes)+' do recorte\n'+n(r.graves)+' graves/fatais · '+pct(r.percentualGrave)+'\n'+n(r.feridos)+' feridos · '+n(r.mortes)+' mortes')+'""><span class=""ld-rank-label""><span class=""ld-rank-name"">'+esc(r.name)+'</span><span class=""ld-rank-value"">'+(metric==='percentualGrave'?pct(r.percentualGrave):n(r.acidentes))+'</span></span><span class=""ld-track""><i style=""width:'+100*r[metric]/maximum+'%""></i></span>'+(metric==='percentualGrave'?'<span class=""ld-rank-context"">'+n(r.graves)+' graves/fatais em '+n(r.acidentes)+' ocorrências</span>':'')+'</button>').join('');}
        ranks('[data-municipios]',municipality,'municipio');ranks('[data-tipos]',typeRanks,'tipo');
        ranks('[data-causas]',causeRanks,'causa');ranks('[data-rodovias]',roadRanks,'rodovia','percentualGrave');
        const pistes=ranked(rows,'pista').sort(byVolume);lastPistas=pistes;
        el('[data-pista-alert]').textContent=n(pistes.filter(p=>p.mortes>0).length)+' de '+n(pistes.length)+' tipos de pista com mortes registradas neste recorte.';
        el('[data-pistas]').innerHTML=pistes.map(p=>{const status=p.mortes>0?'fatal':p.feridosGraves>0?'grave':'sem-graves';const label=p.mortes>0?'Há mortes registradas':p.feridosGraves>0?'Há feridos graves':'Sem graves/fatais registrados';return '<article class=""ld-pista-card"" data-outcome=""'+status+'""><div class=""ld-pista-head""><h3>'+esc(p.name)+'</h3><strong>'+pct(p.percentualGrave)+'</strong></div><span class=""ld-outcome-tag"">'+(status==='fatal'?'! ':status==='grave'?'△ ':'• ')+label+'</span><dl class=""ld-pista-numbers""><div><dt>Ocorrências</dt><dd>'+n(p.acidentes)+'</dd></div><div><dt>Graves/fatais</dt><dd>'+n(p.graves)+'</dd></div><div><dt>Feridos</dt><dd>'+n(p.feridos)+'</dd></div><div><dt>Mortes</dt><dd>'+n(p.mortes)+'</dd></div></dl></article>';}).join('');
        renderTable();
        el('[data-table-total]').textContent=n(a.trechos.length)+' trechos no recorte';
        el('[data-quality]').textContent=n(a.comAlertas)+' registros com inconsistências na fonte; valores preservados.';
        drawMonthly();
      }
      root.queryS" &
"electorAll('[data-focus]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.focus===state.focus)));el('[data-focus-note]').textContent=state.focus==='volume'?'Trechos por quantidade de acidentes. Foco altera a tabela e a leitura de decisão; os indicadores mantêm o recorte.':(state.focus==='high'?'Maior':'Menor')+' proporção grave/fatal entre acidentes registrados. Observe a quantidade: amostras pequenas são instáveis. Não mede risco por veículo.';
      el('[data-status]').textContent=rows.length?'Dados carregados':'Recorte sem registros';
      const track=el('.ld-ticker-track');if(track)track.style.setProperty('--ld-ticker-shift',Math.min(0,el('[data-ticker]').clientWidth-track.scrollWidth)+'px');
      root.dataset.ready='true';
    }
    const stamp=data.meta.atualizadoEmUTC?new Date(data.meta.atualizadoEmUTC):null;
    el('[data-updated]').textContent=stamp&&!Number.isNaN(stamp.valueOf())?'Carga do modelo: '+new Intl.DateTimeFormat('pt-BR',{timeZone:'America/Sao_Paulo',dateStyle:'short',timeStyle:'short'}).format(stamp)+' BRT':'Data de carga não informada';
    options();render();
    root.addEventListener('input',e=>{if(e.target.matches('[data-filter-search]')){query=e.target.value;drawChoices();}});
    root.addEventListener('change',e=>{const c=e.target.closest('[data-choice]');if(!c)return;e.stopPropagation();let k=c.dataset.choice,vs=[c.value];if(c.dataset.group){if(k==='mes')vs=[...new Set((data.seriesMensais||[]).map(r=>r.mes))].filter(v=>v.startsWith(c.value));else if(k==='tipo')vs=[...new Set(base.filter(r=>typeCategory(r.tipo)===c.value).map(r=>r.tipo))];else{k='trechoChave';vs=[...new Set(base.filter(r=>r.rodovia===c.value).map(r=>r.trechoChave))];}}if(k==='trechoChave'&&state.filters.rodovia.length){state.filters.trechoChave=[...new Set([...state.filters.trechoChave,...base.filter(r=>state.filters.rodovia.includes(r.rodovia)).map(r=>r.trechoChave)])];state.filters.rodovia=[];}setFilter(k,c.checked?[...state.filters[k],...vs]:state.filters[k].filter(v=>!vs.includes(v)));drawChoices();});
    root.addEventListener('click',e=>{const f=e.target.closest('[data-focus]');if(f){e.stopPropagation();state.focus=f.dataset.focus;state.sort={key:state.focus==='volume'?'acidentes':'percentualGrave',dir:state.focus==='low'?'asc':'desc'};save();render();}const p=e.target.closest('[data-picker]');if(p){e.stopPropagation();openPopup(p);}if(e.target.closest('[data-popup-close]'))closePopup();if(e.target.closest('[data-filter-reset]')){const k=opened;setFilter(k,[]);if(k==='rodovia')setFilter('trechoChave',[]);drawChoices();}const t=e.target.closest('[data-investigate]');if(t){e.stopPropagation();setFilter('trechoChave',[t.dataset.investigate]);}});
    document.addEventListener('click',e=>{if(!root.contains(e.target)||!e.target.closest('[data-popup],[data-picker]'))closePopup();});
    root.addEventListener('keydown',e=>{if(e.key==='Escape'&&opened){const b=el('[data-picker=""'+opened+'""]');closePopup();b?.focus();}});
    root.addEventListener('click',e=>{
      const clear=e.target.closest('[data-clear]'),theme=e.target.closest('[data-theme-toggle]'),rank=e.target.closest('[data-filter-kind]'),month=e.target.closest('[data-month]'),sort=e.target.closest('[data-sort]');
      if(clear){e.stopPropagation();keys.forEach(k=>state.filters[k]=[]);closePopup();options();save();render();}
      if(theme){e.stopPropagation();state.theme=state.theme==='dark'?'light':'dark';save();render();}
      if(rank){e.stopPropagation();toggleFilter(rank.dataset.filterKind,rank.dataset.filterValue,e.ctrlKey||e.metaKey);}
      if(month){e.stopPropagation();toggleFilter('mes',month.dataset.month,e.ctrlKey||e.metaKey);}
      if(sort){e.stopPropagation();const key=sort.dataset.sort;if(sortKeys.includes(key)){state.sort={key,dir:state.sort.key===key&&state.sort.dir==='asc'?'desc':'asc'};save();renderTable();}}
    });
    root.addEventListener('keydown',e=>{const month=e.target.closest('[data-month]');if(month&&(e.key==='Enter'||e.key===' ')){e.preventDefault();e.stopPropagation();toggleFilter('mes',month.dataset.month,e.ctrlKey||e.metaKey);}});
    const tip=el('.ld-tooltip');
    function showTip(target,x,y){if(!target?.dataset.tip){tip.hidden=true;return;}tip.textContent=target.dataset.tip;tip.hidden=false;const rb=root.getBoundingClientRect(),tb=tip.getBoundingClientRect();const minX=Math.max(5,rb.left+5),maxX=Math.min(window.innerWidth-8,rb.right-5)-tb.width;const minY=Math.max(5,rb.top+5),maxY=Math.min(window.innerHeight-8,rb.bottom-5)-tb.height;tip.style.left=Math.max(minX,Math.min(x+12,maxX))+'px';tip.style.top=Math.max(minY,Math.min(y-tb.height-12,maxY))+'px';}
    root.addEventListener('keydown',()=>tip.hidden=true);
    root.addEventListener('pointermove',e=>showTip(e.target.closest('[data-tip]'),e.clientX,e.clientY));
    root.addEventListener('pointerleave',()=>tip.hidden=true);
    root.addEventListener('focusin',e=>{const t=e.target.closest('[data-tip]');if(t){const b=t.getBoundingClientRect();showTip(t,b.left,b.bottom);}});
    root.addEventListener('focusout',()=>tip.hidden=true);
    if(window.__ldPRFObserver)window.__ldPRFObserver.disconnect();
    if(typeof ResizeObserver!=='undefined'){let width=0;window.__ldPRFObserver=new ResizeObserver(entries=>{const w=entries[0]?.contentRect.width;if(w!==width){width=w;drawMonthly();const t=el('.ld-ticker-track');if(t)t.style.setProperty('--ld-ticker-shift',Math.min(0,el('[data-ticker]').clientWidth-t.scrollWidth)+'px');}});window.__ldPRFObserver.observe(el('[data-monthly]'));}
    root.__ldApp={snapshot:()=>({focus:state.focus,stats:{...lastStats,trechos:lastStats?.trechos?.slice(0,10)},series:lastSeries,median:lastMedian,executive:lastExecutive,roads:lastRoads,pistas:lastPistas,sparkSeries:lastSparkSeries.map(s=>({mes:s.mes,acidentes:s.acidentes,percentualGrave:s.percentualGrave,mortes:s.mortes,feridos:s.feridos,percentualNoite:s.percentualNoite,concentracaoTop5:s.concentracaoTop5})),sort:{...state.sort},filters:{...state.filters},theme:state.theme,rows:lastRows.map(r=>r.id)}),setFilter,baseCount:base.length};
  }catch(error){
    const style=root.querySelector('style')?.outerHTML||'';
    root.dataset.ready='error';root.innerHTML=style+'<section class=""ld-empty""><h2>Dados indisponíveis</h2><p>Não foi possível carregar este recorte. Verifique a fonte do painel no relatório.</p></section>';
    console.error('Dashboard PRF:',error);
  }
})();
</script></div>"
RETURN IF(ISBLANK(_Json), "<div>Dados indisponíveis para este recorte.</div>", _Inicio & _Seguro & _Fim)
