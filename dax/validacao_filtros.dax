EVALUATE UNION(CALCULATETABLE(ROW("Cenario", "Geral", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes])),
CALCULATETABLE(ROW("Cenario", "Ano 2025", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dCalendario[Ano] = 2025),
CALCULATETABLE(ROW("Cenario", "Janeiro 2025", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dCalendario[AnoMes] = "2025-01"),
CALCULATETABLE(ROW("Cenario", "BR116", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dTrecho[BRNumero] = 116),
CALCULATETABLE(ROW("Cenario", "Fortaleza", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dLocalidade[Municipio] = "FORTALEZA"),
CALCULATETABLE(ROW("Cenario", "Tipo animal", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dTipoAcidente[TipoAcidente] = "Atropelamento de Animal"),
CALCULATETABLE(ROW("Cenario", "Plena noite", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dCondicoesVia[FaseDia] = "Plena Noite"),
CALCULATETABLE(ROW("Cenario", "Pista simples", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dCondicoesVia[TipoPista] = "Simples"),
CALCULATETABLE(ROW("Cenario", "Chuva", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dCondicoesVia[CondicaoMeteorologica] = "Chuva"),
CALCULATETABLE(ROW("Cenario", "Urbano", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dCondicoesVia[UsoSolo] = "Urbano"),
CALCULATETABLE(ROW("Cenario", "Causa caixa equivalente", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dCausa[CausaRegistrada] = "Transitar no acostamento"),
CALCULATETABLE(ROW("Cenario", "Filtros combinados", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dCalendario[AnoMes] = "2025-01", dTrecho[BRNumero] = 116, dLocalidade[Municipio] = "FORTALEZA"),
CALCULATETABLE(ROW("Cenario", "Sem registros", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dLocalidade[Municipio] = "__SEM_REGISTROS__"),
CALCULATETABLE(ROW("Cenario", "Sem graves", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), fAcidentes[FlagGraveFatal] = FALSE()),
CALCULATETABLE(ROW("Cenario", "Classificacao ausente", "Acidentes", [Acidentes], "Feridos", [Pessoas feridas], "Mortes", [Mortes registradas], "Graves", [Acidentes graves ou fatais], "PercentualGrave", [Percentual grave ou fatal], "PercentualNoite", [Percentual em plena noite], "ConcentracaoTop5", [Concentracao top 5 trechos], "PessoasDivergentes", [Ocorrencias pessoas divergentes]), dGravidade[ClassificacaoPRF] = "Não informado"))