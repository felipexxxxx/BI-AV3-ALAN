cidentes[Longitude]), FORMAT(fAcidentes[Longitude], "0", "en-US"), FORMAT(fAcidentes[Longitude], "0.###############", "en-US"))) & "," & """p"":" & IF(ISBLANK(fAcidentes[Pessoas]), "null", FORMAT(fAcidentes[Pessoas], "0", "en-US")) & "," & """f"":" & IF(ISBLANK(fAcidentes[Feridos]), "null", FORMAT(fAcidentes[Feridos], "0", "en-US")) & "," & """fg"":" & IF(ISBLANK(fAcidentes[FeridosGraves]), "null", FORMAT(fAcidentes[FeridosGraves], "0", "en-US")) & "," & """m"":" & IF(ISBLANK(fAcidentes[Mortos]), "null", FORMAT(fAcidentes[Mortos], "0", "en-US")) & "," & """ve"":" & IF(ISBLANK(fAcidentes[Veiculos]), "null", FORMAT(fAcidentes[Veiculos], "0", "en-US")) & "," & """q"":" & IF(fAcidentes[FlagQualidade], "true", "false") & "," & """qp"":" & IF(fAcidentes[FlagPessoasDivergentes], "true", "false") & "," & """qc"":" & IF(fAcidentes[FlagClassificacaoDivergente], "true", "false") & "," & """qa"":" & IF(fAcidentes[FlagClassificacaoAusente], "true", "false") & "}", ",", fAcidentes[IDAcidente], ASC) & "]" & "}"
