JSON Gold Dashboard PRF =
VAR _Loc = SUMMARIZE(fAcidentes, dLocalidade[LocalidadeKey], dLocalidade[UF], dLocalidade[Municipio])
VAR _Trechos = SUMMARIZE(fAcidentes, dTrecho[TrechoKey], dTrecho[Rodovia], dTrecho[KmInicial], dTrecho[KmFinalExclusivo], dTrecho[Trecho])
VAR _Condicoes = SUMMARIZE(fAcidentes, dCondicoesVia[CondicoesViaKey], dCondicoesVia[FaseDia], dCondicoesVia[TipoPista], dCondicoesVia[CondicaoMeteorologica], dCondicoesVia[TracadoVia], dCondicoesVia[SentidoVia], dCondicoesVia[UsoSolo])
VAR _Tipos = SUMMARIZE(fAcidentes, dTipoAcidente[TipoAcidente])
VAR _Causas = SUMMARIZE(fAcidentes, dCausa[CausaRegistrada])
VAR _Gravidades = SUMMARIZE(fAcidentes, dGravidade[ClassificacaoPRF])
VAR _Meses = VALUES(dCalendario[AnoMes])
VAR _RankTrechos = TOPN(10, FILTER(ADDCOLUMNS(SUMMARIZE(fAcidentes,dTrecho[TrechoKey],dTrecho[Trecho]),"@N",[Acidentes]), [@N]>0), [@N],DESC,dTrecho[TrechoKey],ASC)
VAR _RankMunicipios = TOPN(10, FILTER(ADDCOLUMNS(SUMMARIZE(fAcidentes,dLocalidade[LocalidadeKey],dLocalidade[Municipio]),"@N",[Acidentes]), [@N]>0), [@N],DESC,dLocalidade[LocalidadeKey],ASC)
VAR _RankTipos = TOPN(10, FILTER(ADDCOLUMNS(SUMMARIZE(fAcidentes,dTipoAcidente[TipoAcidente]),"@N",[Acidentes]), [@N]>0), [@N],DESC,dTipoAcidente[TipoAcidente],ASC)
RETURN
"{" & """meta"":" & "{" & """versaoContrato"":" & """1.0""" & "," & """titulo"":" & """Segurança viária · Ceará""" & "," & """subtitulo"":" & """Frequência e gravidade nas BRs 116 e 222""" & "," & """fonte"":" & """Polícia Rodoviária Federal · dados por ocorrência""" & "," & """escopo"":" & """Ceará · BR-116 e BR-222 · 2021–2025""" & "," & """atualizadoEmUTC"":" & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(FORMAT(MAX(auditoriaImportacao[AtualizadoEmUTC]), "yyyy-MM-ddTHH:mm:ss", "en-US") & "Z", ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """dataInicio"":" & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(FORMAT(MIN(dCalendario[Data]), "yyyy-MM-dd", "en-US"), ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """dataFim"":" & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(FORMAT(MAX(dCalendario[Data]), "yyyy-MM-dd", "en-US"), ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """baseCompleta"":" & "true" & "," & """linhas"":" & IF(ISBLANK(COUNTROWS(fAcidentes)), "null", FORMAT(COUNTROWS(fAcidentes), "0", "en-US")) & "," & """trechoKm"":" & "10" & "," & """limite"":" & """Ocorrências registradas; não representa risco por fluxo de tráfego. Vítimas são pessoas.""" & "}" & "," & """kpis"":" & "{" & """acidentes"":" & IF(ISBLANK([Acidentes]), "null", IF([Acidentes] = INT([Acidentes]), FORMAT([Acidentes], "0", "en-US"), FORMAT([Acidentes], "0.###############", "en-US"))) & "," & """graves"":" & IF(ISBLANK([Acidentes graves ou fatais]), "null", IF([Acidentes graves ou fatais] = INT([Acidentes graves ou fatais]), FORMAT([Acidentes graves ou fatais], "0", "en-US"), FORMAT([Acidentes graves ou fatais], "0.###############", "en-US"))) & "," & """percentualGrave"":" & IF(ISBLANK([Percentual grave ou fatal]), "null", IF([Percentual grave ou fatal] = INT([Percentual grave ou fatal]), FORMAT([Percentual grave ou fatal], "0", "en-US"), FORMAT([Percentual grave ou fatal], "0.###############", "en-US"))) & "," & """feridos"":" & IF(ISBLANK([Pessoas feridas]), "null", IF([Pessoas feridas] = INT([Pessoas feridas]), FORMAT([Pessoas feridas], "0", "en-US"), FORMAT([Pessoas feridas], "0.###############", "en-US"))) & "," & """mortes"":" & IF(ISBLANK([Mortes registradas]), "null", IF([Mortes registradas] = INT([Mortes registradas]), FORMAT([Mortes registradas], "0", "en-US"), FORMAT([Mortes registradas], "0.###############", "en-US"))) & "," & """plenaNoite"":" & IF(ISBLANK([Acidentes em plena noite]), "null", IF([Acidentes em plena noite] = INT([Acidentes em plena noite]), FORMAT([Acidentes em plena noite], "0", "en-US"), FORMAT([Acidentes em plena noite], "0.###############", "en-US"))) & "," & """percentualNoite"":" & IF(ISBLANK([Percentual em plena noite]), "null", IF([Percentual em plena noite] = INT([Percentual em plena noite]), FORMAT([Percentual em plena noite], "0", "en-US"), FORMAT([Percentual em plena noite], "0.###############", "en-US"))) & "," & """concentracaoTop5"":" & IF(ISBLANK([Concentracao top 5 trechos]), "null", IF([Concentracao top 5 trechos] = INT([Concentracao top 5 trechos]), FORMAT([Concentracao top 5 trechos], "0", "en-US"), FORMAT([Concentracao top 5 trechos], "0.###############", "en-US"))) & "," & """comAlertas"":" & IF(ISBLANK([Ocorrencias com alertas]), "null", IF([Ocorrencias com alertas] = INT([Ocorrencias com alertas]), FORMAT([Ocorrencias com alertas], "0", "en-US"), FORMAT([Ocorrencias com alertas], "0.###############", "en-US"))) & "," & """pessoasDivergentes"":" & IF(ISBLANK([Ocorrencias pessoas divergentes]), "null", IF([Ocorrencias pessoas divergentes] = INT([Ocorrencias pessoas divergentes]), FORMAT([Ocorrencias pessoas divergentes], "0", "en-US"), FORMAT([Ocorrencias pessoas divergentes], "0.###############", "en-US"))) & "}" & "," & """seriesMensais"":" & "[" & CONCATENATEX(_Meses, "{" & """mes"":" & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(dCalendario[AnoMes], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """acidentes"":" & IF(ISBLANK([Acidentes]), "null", FORMAT([Acidentes], "0", "en-US")) & "," & """graves"":" & IF(ISBLANK([Acidentes graves ou fatais]), "null", FORMAT([Acidentes graves ou fatais], "0", "en-US")) & "," & """feridos"":" & IF(ISBLANK([Pessoas feridas]), "null", FORMAT([Pessoas feridas], "0", "en-US")) & "," & """mortes"":" & IF(ISBLANK([Mortes registradas]), "null", FORMAT([Mortes registradas], "0", "en-US")) & "," & """percentualGrave"":" & IF(ISBLANK([Percentual grave ou fatal]), "null", IF([Percentual grave ou fatal] = INT([Percentual grave ou fatal]), FORMAT([Percentual grave ou fatal], "0", "en-US"), FORMAT([Percentual grave ou fatal], "0.###############", "en-US"))) & "}", ",", dCalendario[AnoMes], ASC) & "]" & "," & """rankings"":" & "{" & """trechos"":" & "[" & CONCATENATEX(_RankTrechos, "{" & """k"":" & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(dTrecho[TrechoKey], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """rotulo"":" & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(dTrecho[Trecho], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """acidentes"":" & IF(ISBLANK([Acidentes]), "null", FORMAT([Acidentes], "0", "en-US")) & "," & """graves"":" & IF(ISBLANK([Acidentes graves ou fatais]), "null", FORMAT([Acidentes graves ou fatais], "0", "en-US")) & "," & """feridos"":" & IF(ISBLANK([Pessoas feridas]), "null", FORMAT([Pessoas feridas], "0", "en-US")) & "," & """mortes"":" & IF(ISBLANK([Mortes registradas]), "null", FORMAT([Mortes registradas], "0", "en-US")) & "," & """percentualGrave"":" & IF(ISBLANK([Percentual grave ou fatal]), "null", IF([Percentual grave ou fatal] = INT([Percentual grave ou fatal]), FORMAT([Percentual grave ou fatal], "0", "en-US"), FORMAT([Percentual grave ou fatal], "0.###############", "en-US"))) & "}", ",", dTrecho[TrechoKey], ASC) & "]" & "," & """municipios"":" & "[" & CONCATENATEX(_RankMunicipios, "{" & """k"":" & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(dLocalidade[LocalidadeKey], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """rotulo"":" & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(dLocalidade[Municipio], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """acidentes"":" & IF(ISBLANK([Acidentes]), "null", FORMAT([Acidentes], "0", "en-US")) & "," & """graves"":" & IF(ISBLANK([Acidentes graves ou fatais]), "null", FORMAT([Acidentes graves ou fatais], "0", "en-US")) & "," & """feridos"":" & IF(ISBLANK([Pessoas feridas]), "null", FORMAT([Pessoas feridas], "0", "en-US")) & "," & """mortes"":" & IF(ISBLANK([Mortes registradas]), "null", FORMAT([Mortes registradas], "0", "en-US")) & "," & """percentualGrave"":" & IF(ISBLANK([Percentual grave ou fatal]), "null", IF([Percentual grave ou fatal] = INT([Percentual grave ou fatal]), FORMAT([Percentual grave ou fatal], "0", "en-US"), FORMAT([Percentual grave ou fatal], "0.###############", "en-US"))) & "}", ",", dLocalidade[LocalidadeKey], ASC) & "]" & "," & """tipos"":" & "[" & CONCATENATEX(_RankTipos, "{" & """rotulo"":" & """" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(dTipoAcidente[TipoAcidente], ""), "\", "\\"), """", "\"""), UNICHAR(13), "\r"), UNICHAR(10), "\n"), UNICHAR(9), "\t") & """" & "," & """acidentes"":" & IF(ISBLANK([Acidentes]), "null", FORMAT([Acidentes], "0", "en-US")) & "," & """graves"":" & IF(ISBLANK([Acidentes graves ou fatais]), "null", FORMAT([Acidentes graves ou fatais], "0", "en-US")) & "," & """feridos"":" & IF(ISBLANK([Pessoas feridas])