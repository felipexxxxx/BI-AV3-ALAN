HTML Capa PRF =
VAR _Json = [JSON Gold Dashboard PRF]
VAR _Seguro = SUBSTITUTE(_Json, "<", "\u003c")
VAR _Inicio = "<div id=""cp-prf-root"" class=""cp-root""><style>.cp-root{--cp-bg:#09131e;--cp-panel:#122333;--cp-fg:#edf5ff;--cp-muted:#abc0d5;--cp-accent:#39d4c7;--cp-alert:#ffc56b;--cp-line:#294152;--cp-radius:20px;box-sizing:border-box;position:relative;min-height:760px;padding:40px;font:15px/1.6 Segoe UI,Arial,sans-serif;background:radial-gradient(ellipse at 75% 25%,#163345,transparent 60%),var(--cp-bg);color:var(--cp-fg);overflow:hidden}.cp-root *{box-sizing:border-box}.cp-header{display:flex;justify-content:space-between;gap:20px;color:var(--cp-muted);font-size:12px;letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid var(--cp-line);padding-bottom:20px}.cp-brand{color:var(--cp-accent);font-weight:700}.cp-main{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:50px;align-items:center;padding:48px 0 26px}.cp-kicker{font-size:12px;letter-spacing:2px;color:var(--cp-accent)}.cp-title{font-size:clamp(32px,4.5vw,62px);line-height:1.1;letter-spacing:-2px;margin:20px 0 28px;max-width:700px}.cp-typing{animation:cp-type 1s steps(30,end) both;display:block;clip-path:inset(0 0 0 0)}.cp-copy{color:var(--cp-muted);max-width:580px}.cp-scope{display:inline-block;margin-top:18px;border:1px solid var(--cp-line);border-radius:30px;padding:8px 16px;color:var(--cp-muted);font-size:12px}.cp-executive{border-left:1px solid var(--cp-line);padding-left:35px}.cp-ring-wrap{position:relative;width:210px;height:210px;margin:0 auto}.cp-ring{width:100%;height:100%;transform:rotate(-90deg)}.cp-ring circle{fill:none;stroke-width:9}.cp-ring-bg{stroke:var(--cp-line)}.cp-ring-fill{stroke:var(--cp-alert);stroke-linecap:round;stroke-dasharray:565.4867;stroke-dashoffset:565.4867}.cp-ring-number{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}.cp-number{font-size:43px;font-weight:700;font-variant-numeric:tabular-nums;color:var(--cp-alert)}.cp-ring-label{font-size:12px;color:var(--cp-muted)}.cp-executive h2{font-size:19px;text-align:center;margin:14px 0 8px}.cp-executive p{font-size:12px;color:var(--cp-muted);text-align:center}.cp-spark{display:block;width:100%;height:80px;margin-top:16px}.cp-spark path{stroke:var(--cp-accent);stroke-width:2;fill:none}.cp-delta{color:var(--cp-muted);font-size:12px;text-align:center}.cp-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;border-block:1px solid var(--cp-line);padding:22px 0;margin-top:8px}.cp-fact strong{display:block;font-size:28px}.cp-fact span{color:var(--cp-muted);font-size:12px}.cp-bottom{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:32px;margin-top:28px;align-items:end}.cp-source{font-size:11px;color:var(--cp-muted);max-width:700px}.cp-nav-space{height:72px;border:1px dashed var(--cp-line);border-radius:12px;display:grid;place-content:center;text-align:center;font-size:12px;color:var(--cp-muted);pointer-events:none}.cp-road{position:relative;height:36px;margin-top:30px;pointer-events:none;border-block:1px solid var(--cp-line);overflow:hidden}.cp-road:before{content:"""";position:absolute;top:17px;left:0;right:0;height:1px;background:repeating-linear-gradient(90deg,var(--cp-muted) 0 20px,transparent 20px 42px)}.cp-car{position:absolute;top:5px;left:-30px;width:24px;height:8px;border-radius:4px;background:var(--cp-accent);animation:cp-drive 12s linear 2 both}.cp-car:nth-child(2){top:24px;animation-delay:2s;animation-direction:reverse;background:var(--cp-alert)}.cp-car:nth-child(3){animation-delay:5s}.cp-error{padding:40px;color:var(--cp-fg)}@keyframes cp-drive{from{left:-30px}to{left:calc(100% + 30px)}}@keyframes cp-type{from{clip-path:inset(0 100% 0 0)}to{clip-path:inset(0 0 0 0)}}@media(max-width:800px){.cp-root{padding:24px}.cp-main{grid-template-columns:1fr;gap:24px;padding-top:24px}.cp-executive{border-left:0;border-top:1px solid var(--cp-line);padding:24px 0 0}.cp-title{letter-spacing:-1px}.cp-facts{gap:10px}.cp-fact strong{font-size:24px}.cp-bottom{grid-template-columns:1fr}.cp-nav-space{width:230px;justify-self:end}.cp-header{flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){.cp-root *{animation:none!important;transition:none!important}.cp-car{left:25%}.cp-car:nth-child(2){left:55%}.cp-car:nth-child(3){left:80%}}
@media(min-width:801px){.cp-root{min-height:700px;padding:24px}.cp-header{padding-bottom:12px}.cp-main{padding:20px 0 16px;gap:30px}.cp-title{font-size:44px;margin:12px 0 16px}.cp-copy{font-size:13px}.cp-scope{margin-top:10px;padding:6px 12px}.cp-ring-wrap{width:150px;height:150px}.cp-number{font-size:34px}.cp-executive h2{margin:8px 0 4px;font-size:17px}.cp-executive p{margin:6px 0}.cp-spark{height:58px;margin-top:8px}.cp-facts{padding:14px 0}.cp-fact strong{font-size:24px}.cp-road{height:26px;margin-top:16px}.cp-road:before{top:12px}.cp-car{top:3px}.cp-car:nth-child(2){top:16px}.cp-bottom{margin-top:16px;gap:24px}.cp-nav-space{height:56px}.cp-source{font-size:10px}}
</style><script type=""application/json"" class=""cp-data"">"
VAR _Fim = "</script><header class=""cp-header""><span class=""cp-brand"">// Observatório viário · Ceará</span><span>PRF · BR-116 / BR-222</span></header>
<main class=""cp-main""><section><div class=""cp-kicker"">DADOS PARA ORIENTAR A PREVENÇÃO</div><h1 class=""cp-title""><span class=""cp-typing"">Cada ocorrência ajuda a decidir onde agir.</span></h1><p class=""cp-copy"">Explore onde e quando se concentram os acidentes graves. Transforme registros em prioridades de investigação e vistoria.</p><span class=""cp-scope"" data-cp-period></span></section><section class=""cp-executive""><div class=""cp-ring-wrap""><svg class=""cp-ring"" viewBox=""0 0 200 200"" aria-hidden=""true""><circle class=""cp-ring-bg"" cx=""100"" cy=""100"" r=""90""/><circle class=""cp-ring-fill"" cx=""100"" cy=""100"" r=""90""/></svg><div class=""cp-ring-number""><strong class=""cp-number"" data-cp-number>—</strong><span class=""cp-ring-label"">das ocorrências</span></div></div><h2>Graves ou fatais</h2><p>Proporção registrada no contexto atual.<br>O anel representa participação, sem meta de desempenho.</p><svg class=""cp-spark"" viewBox=""0 0 480 80"" role=""img"" aria-label=""Tendência mensal da proporção grave ou fatal""></svg><div class=""cp-delta"" data-cp-delta></div></section></main>
<section class=""cp-facts"" aria-label=""Resumo do contexto""><div class=""cp-fact""><strong data-cp-total>—</strong><span>ocorrências analisadas</span></div><div class=""cp-fact""><strong data-cp-deaths>—</strong><span>mortes registradas</span></div><div class=""cp-fact""><strong data-cp-injured>—</strong><span>pessoas feridas</span></div></section>
<div class=""cp-road"" aria-hidden=""true""><i class=""cp-car""></i><i class=""cp-car""></i><i class=""cp-car""></i></div>
<footer class=""cp-bottom""><div class=""cp-source"">Fonte: PRF · Datatran, registros por ocorrência, 2021–2025. Vítimas são pessoas. A concentração observada não equivale a risco por veículo nem comprova causalidade.<br><span data-cp-updated></span><br><span data-cp-quality></span></div><div class=""cp-nav-space"" aria-hidden=""true"">Área do botão nativo<br>Ir para Análise</div></footer>
<script>(function(){'use strict';const root=document.getElementById('cp-prf-root');if(!root)return;const el=s=>root.querySelector(s),fmt=new Intl.NumberFormat('pt-BR',{maximumFractionDigits:1,minimumFractionDigits:1}),n=new Intl.NumberFormat('pt-BR'),pct=v=>v==null?'—':fmt.format(v*100)+'%';try{const data=JSON.parse(el('.cp-data').textContent);if(!data.meta?.baseCompleta||!Array.isArray(data.baseInterativa))throw Error('Contrato incompleto');const rows=data.baseInterativa;if(rows.length!==(data.meta.linhas??0)||new Set(rows.map(r=>r.id)).size!==rows.length)throw Error('Base incompleta');const total=rows.length,graves=rows.filter(r=>r.fg>0||r.m>0).length,value=total?graves/total:null;const monthly=(data.seriesMensais||[]).map(s=>{const rs=rows.filter(r=>r.d.slice(0,7)===s.mes);return {mes:s.mes,n:rs.length,p:rs.length?rs.filter(r=>r.fg>0||r.m>0).length/rs.length:null};}).sort((a,b)=>a.mes.localeCompare(b.mes));el('[data-cp-total]').textContent=n.format(total);el('[data-cp-deaths]').textContent=n.format(rows.reduce((s,r)=>s+r.m,0));el('[data-cp-injured]').textContent=n.format(rows.reduce((s,r)=>s+r.f,0));const dates=rows.map(r=>r.d).sort();const month=m=>new Date(m+'-02T12:00:00').toLocaleDateString('pt-BR',{month:'short',year:'numeric'});el('[data-cp-period]').textContent=dates.length?month(dates[0].slice(0,7))+' — '+month(dates.at(-1).slice(0,7)):'Sem ocorrências no contexto';const stamp=new Date(data.meta.atualizadoEmUTC);el('[data-cp-updated]').textContent=Number.isNaN(+stamp)?'Carga não informada':'Carga do modelo: '+new Intl.DateTimeFormat('pt-BR',{timeZone:'America/Sao_Paulo',dateStyle:'short',timeStyle:'short'}).format(stamp)+' BRT';el('[data-cp-quality]').textContent=n.format(rows.filter(r=>r.q).length)+' ocorrências com alertas de qualidade; registros preservados.';let path='',active=false;monthly.forEach((s,i)=>{if(s.p==null){active=false;return;}path+=(active?'L':'M')+(20+(monthly.length===1?220:i*440/(monthly.length-1)))+','+(70-s.p*60)+' ';active=true;});el('.cp-spark').innerHTML='<path d=""'+path+'""/>';let delta=null;const last=monthly.filter(s=>s.n).at(-1);if(last){const d=new Date(Number(last.mes.slice(0,4)),Number(last.mes.slice(5))-2,1),key=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'),prev=monthly.find(s=>s.mes===key);if(prev?.p!=null){delta=100*(last.p-prev.p);el('[data-cp-delta]').textContent=(delta>0?'↑ +':delta<0?'↓ ':'= ')+fmt.format(delta)+' p.p. · '+month(last.mes)+' vs '+month(key);}}if(delta==null)el('[data-cp-delta]').textContent='Comparação com mês anterior indisponível';const ring=el('.cp-ring-fill'),number=el('[data-cp-number]'),circ=2*Math.PI*90;let frame=null;const paint=v=>{ring.style.strokeDashoffset=String(circ*(1-Math.max(0,Math.min(1,v))));number.textContent=pct(v);};const reduced=matchMedia('(prefers-reduced-motion: reduce)');function final(){if(frame!=null)cancelAnimationFrame(frame);frame=null;if(value==null){number.textContent='—';ring.style.strokeDashoffset=String(circ);}else paint(value);root.dataset.animating='false';}if(value==null||reduced.matches)final();else{root.dataset.animating='true';const start=performance.now();function tick(now){const p=Math.min(1,(now-start)/1100);paint(value*(1-Math.pow(1-p,3)));if(p<1)frame=requestAnimationFrame(tick);else final();}paint(0);frame=requestAnimationFrame(tick);}reduced.addEventListener?.('change',e=>{if(e.matches)final();});root.dataset.ready='true';root.__cpApp={snapshot:()=>({total,graves,value,monthly,delta}),finish:final};}catch(error){root.innerHTML='<div class=""cp-error"" role=""alert"">Não foi possível carregar a capa. Verifique os dados do relatório.</div>';root.dataset.error='true';}})();
</script></div>"
RETURN IF(ISBLANK(_Json), "<div>Dados indisponíveis.</div>", _Inicio & _Seguro & _Fim)