-- Pasta: 01 Base
-- Ocorrencias distintas por IDAcidente. Preserva todos os filtros externos. Zero quando nao houver ocorrencias. Escopo fixo da importacao: CE, BR 116/222, 2021-2025.
Acidentes =
COALESCE(DISTINCTCOUNT(fAcidentes[IDAcidente]), 0)

-- Pasta: 01 Base
-- Total de pessoas informado pela PRF. Ha 212 ocorrencias com divergencia na soma dos estados fisicos; nao usar como denominador de percentuais de vitimas sem revisao. Zero sem ocorrencias; filtros externos preservados.
Pessoas informadas =
COALESCE(SUM(fAcidentes[Pessoas]), 0)

-- Pasta: 01 Base
-- Pessoas com ferimentos leves ou graves. Reconciliada com FeridosLeves + FeridosGraves. Zero sem ocorrencias; filtros externos preservados.
Pessoas feridas =
COALESCE(SUM(fAcidentes[Feridos]), 0)

-- Pasta: 01 Base
-- Pessoas com ferimentos leves registradas na ocorrencia. Zero sem ocorrencias; filtros externos preservados.
Feridos leves =
COALESCE(SUM(fAcidentes[FeridosLeves]), 0)

-- Pasta: 01 Base
-- Pessoas com ferimentos graves registradas na ocorrencia. Zero sem ocorrencias; filtros externos preservados.
Feridos graves =
COALESCE(SUM(fAcidentes[FeridosGraves]), 0)

-- Pasta: 01 Base
-- Pessoas mortas registradas no boletim da PRF. Nao representa animais mortos nem mortalidade de acompanhamento hospitalar. Zero sem ocorrencias; filtros externos preservados.
Mortes registradas =
COALESCE(SUM(fAcidentes[Mortos]), 0)

-- Pasta: 01 Base
-- Pessoas ilesas registradas na fonte. Zero sem ocorrencias; filtros externos preservados.
Pessoas ilesas =
COALESCE(SUM(fAcidentes[Ilesos]), 0)

-- Pasta: 01 Base
-- Pessoas cujo estado fisico nao foi identificado na fonte. Zero sem ocorrencias; filtros externos preservados.
Estado fisico ignorado =
COALESCE(SUM(fAcidentes[Ignorados]), 0)

-- Pasta: 01 Base
-- Veiculos envolvidos nas ocorrencias. Nao corresponde ao fluxo total da rodovia. Zero sem ocorrencias; filtros externos preservados.
Veiculos envolvidos =
COALESCE(SUM(fAcidentes[Veiculos]), 0)

-- Pasta: 02 Gravidade
-- Ocorrencia com FeridosGraves > 0 ou Mortos > 0, contada uma vez mesmo quando houver ambos. Usa contagens, sem corrigir a classificacao original da PRF. Unidade: ocorrencia. KEEPFILTERS intersecta a condicao com os filtros existentes. Zero sem ocorrencias elegiveis.
Acidentes graves ou fatais =
CALCULATE([Acidentes], KEEPFILTERS(fAcidentes[FlagGraveFatal] = TRUE()))

-- Pasta: 02 Gravidade
-- Ocorrencias com pelo menos uma pessoa morta, nao a soma das mortes. Unidade: ocorrencia. KEEPFILTERS intersecta a condicao com os filtros existentes. Zero sem ocorrencias elegiveis.
Acidentes com mortes =
CALCULATE([Acidentes], KEEPFILTERS(fAcidentes[Mortos] > 0))

-- Pasta: 02 Gravidade
-- Ocorrencias com pelo menos uma pessoa ferida. Unidade: ocorrencia. KEEPFILTERS intersecta a condicao com os filtros existentes. Zero sem ocorrencias elegiveis.
Acidentes com feridos =
CALCULATE([Acidentes], KEEPFILTERS(fAcidentes[Feridos] > 0))

-- Pasta: 02 Gravidade
-- Numerador: ocorrencias graves/fatais. Denominador: ocorrencias distintas no mesmo contexto. BLANK sem ocorrencias. Nao mede risco por veiculo.
Percentual grave ou fatal =
DIVIDE([Acidentes graves ou fatais], [Acidentes])

-- Pasta: 02 Gravidade
-- Numerador: ocorrencias com ao menos uma morte. Denominador: ocorrencias distintas no contexto. BLANK com denominador zero.
Percentual com mortes =
DIVIDE([Acidentes com mortes], [Acidentes])

-- Pasta: 03 Distribuicao
-- Ocorrencias cuja FaseDia e exatamente Plena Noite. Amanhecer e Anoitecer nao sao incluidos nessa categoria. Unidade: ocorrencia. KEEPFILTERS intersecta a condicao com os filtros existentes. Zero sem ocorrencias elegiveis.
Acidentes em plena noite =
CALCULATE([Acidentes], KEEPFILTERS(fAcidentes[FlagPlenaNoite] = TRUE()))

-- Pasta: 03 Distribuicao
-- Ocorrencias em sabado ou domingo, pela DataAcidente. Nao pressupoe feriados. Unidade: ocorrencia. KEEPFILTERS intersecta a condicao com os filtros existentes. Zero sem ocorrencias elegiveis.
Acidentes fim de semana =
CALCULATE([Acidentes], KEEPFILTERS(dCalendario[FimDeSemana] = TRUE()))

-- Pasta: 03 Distribuicao
-- Numerador: [Acidentes em plena noite]. Denominador: ocorrencias distintas no mesmo contexto externo. BLANK sem ocorrencias.
Percentual em plena noite =
DIVIDE([Acidentes em plena noite], [Acidentes])

-- Pasta: 03 Distribuicao
-- Numerador: [Acidentes fim de semana]. Denominador: ocorrencias distintas no mesmo contexto externo. BLANK sem ocorrencias.
Percentual fim de semana =
DIVIDE([Acidentes fim de semana], [Acidentes])

-- Pasta: 03 Distribuicao
-- Pessoas feridas por ocorrencia. Pode superar 1, pois uma ocorrencia pode ter diversas vitimas. BLANK sem ocorrencias.
Feridos por acidente =
DIVIDE([Pessoas feridas], [Acidentes])

-- Pasta: 03 Distribuicao
-- Veiculos envolvidos por ocorrencia, sem confundir com fluxo de trafego. BLANK sem ocorrencias.
Veiculos por acidente =
DIVIDE([Veiculos envolvidos], [Acidentes])

-- Pasta: 03 Distribuicao
-- Soma de ocorrencias nos cinco trechos com maior volume dentro dos filtros atuais. Trechos: UF+BR+intervalo analitico de 10 km. Empates desempatados pela chave, garantindo no maximo cinco trechos. Nao remove filtros externos.
Acidentes top 5 trechos =
VAR _Trechos = ADDCOLUMNS(VALUES(dTrecho[TrechoKey]), "@Acidentes", [Acidentes])
VAR _Top = TOPN(5, _Trechos, [@Acidentes], DESC, dTrecho[TrechoKey], ASC)
RETURN COALESCE(SUMX(_Top, [@Acidentes]), 0)

-- Pasta: 03 Distribuicao
-- Numerador: ocorrencias nos cinco trechos de maior volume no recorte. Denominador: todas as ocorrencias do mesmo recorte. BLANK sem dados; nao mede risco por fluxo.
Concentracao top 5 trechos =
DIVIDE([Acidentes top 5 trechos], [Acidentes])

-- Pasta: 04 Qualidade
-- Ocorrencias com pelo menos uma flag de qualidade, contadas uma unica vez. Unidade: ocorrencia. KEEPFILTERS intersecta a condicao com os filtros existentes. Zero sem ocorrencias elegiveis.
Ocorrencias com alertas =
CALCULATE([Acidentes], KEEPFILTERS(fAcidentes[FlagQualidade] = TRUE()))

-- Pasta: 04 Qualidade
-- Divergencia entre Pessoas e a soma dos estados fisicos registrados. Valores mantidos sem correcao artificial. Unidade: ocorrencia. KEEPFILTERS intersecta a condicao com os filtros existentes. Zero sem ocorrencias elegiveis.
Ocorrencias pessoas divergentes =
CALCULATE([Acidentes], KEEPFILTERS(fAcidentes[FlagPessoasDivergentes] = TRUE()))

-- Pasta: 04 Qualidade
-- Presenca/ausencia de Mortos inconsistente com a classificacao original Com Vitimas Fatais. Unidade: ocorrencia. KEEPFILTERS intersecta a condicao com os filtros existentes. Zero sem ocorrencias elegiveis.
Ocorrencias classificacao divergente =
CALCULATE([Acidentes], KEEPFILTERS(fAcidentes[FlagClassificacaoDivergente] = TRUE()))

-- Pasta: 04 Qualidade
-- Classificacao original vazia ou sentinela NA. Nao e uma nova classe de gravidade. Unidade: ocorrencia. KEEPFILTERS intersecta a condicao com os filtros existentes. Zero sem ocorrencias elegiveis.
Ocorrencias classificacao ausente =
CALCULATE([Acidentes], KEEPFILTERS(fAcidentes[FlagClassificacaoAusente] = TRUE()))

-- Pasta: 04 Qualidade
-- Pelo menos um campo numerico, de data ou horario nao pode ser convertido segundo o contrato de origem. Unidade: ocorrencia. KEEPFILTERS intersecta a condicao com os filtros existentes. Zero sem ocorrencias elegiveis.
Ocorrencias erro conversao =
CALCULATE([Acidentes], KEEPFILTERS(fAcidentes[FlagConversao] = TRUE()))

-- Pasta: 04 Qualidade
-- Ocorrencias com alertas divididas pelas ocorrencias do contexto. BLANK sem dados. Nao exclui as ocorrencias sinalizadas.
Percentual com alertas =
DIVIDE([Ocorrencias com alertas], [Acidentes])

-- Pasta: 05 Temporal\Acidentes
-- Requer um unico ano-mes no contexto. Desloca somente o calendario em um mes e preserva os filtros das outras dimensoes. BLANK para selecao de varios meses ou periodo anterior fora do calendario.
Acidentes mes anterior =
VAR _Datas = DATEADD(dCalendario[Data], -1, MONTH)
RETURN IF(HASONEVALUE(dCalendario[AnoMesOrdem]) && NOT ISEMPTY(_Datas), CALCULATE([Acidentes], _Datas))

-- Pasta: 05 Temporal\Acidentes
-- Diferenca do valor atual para o mes anterior no mesmo recorte; BLANK sem mes anterior elegivel. Para gravidade, a diferenca e de proporcoes, exibida em pontos percentuais.
Acidentes variacao mensal absoluta =
VAR _Anterior = [Acidentes mes anterior] RETURN IF(NOT ISBLANK(_Anterior), [Acidentes] - _Anterior)

-- Pasta: 05 Temporal\Acidentes
-- Variacao relativa contra o mes anterior. DIVIDE retorna BLANK se o valor anterior for zero ou ausente. Nao e limitada a 0-100%, pois e variacao, nao participacao.
Acidentes variacao mensal percentual =
VAR _Anterior = [Acidentes mes anterior] RETURN IF(NOT ISBLANK(_Anterior), DIVIDE([Acidentes] - _Anterior, _Anterior))

-- Pasta: 05 Temporal\Mortes
-- Requer um unico ano-mes no contexto. Desloca somente o calendario em um mes e preserva os filtros das outras dimensoes. BLANK para selecao de varios meses ou periodo anterior fora do calendario.
Mortes mes anterior =
VAR _Datas = DATEADD(dCalendario[Data], -1, MONTH)
RETURN IF(HASONEVALUE(dCalendario[AnoMesOrdem]) && NOT ISEMPTY(_Datas), CALCULATE([Mortes registradas], _Datas))

-- Pasta: 05 Temporal\Mortes
-- Diferenca do valor atual para o mes anterior no mesmo recorte; BLANK sem mes anterior elegivel. Para gravidade, a diferenca e de proporcoes, exibida em pontos percentuais.
Mortes variacao mensal absoluta =
VAR _Anterior = [Mortes mes anterior] RETURN IF(NOT ISBLANK(_Anterior), [Mortes registradas] - _Anterior)

-- Pasta: 05 Temporal\Mortes
-- Variacao relativa contra o mes anterior. DIVIDE retorna BLANK se o valor anterior for zero ou ausente. Nao e limitada a 0-100%, pois e variacao, nao participacao.
Mortes variacao mensal percentual =
VAR _Anterior = [Mortes mes anterior] RETURN IF(NOT ISBLANK(_Anterior), DIVIDE([Mortes registradas] - _Anterior, _Anterior))

-- Pasta: 05 Temporal\Feridos
-- Requer um unico ano-mes no contexto. Desloca somente o calendario em um mes e preserva os filtros das outras dimensoes. BLANK para selecao de varios meses ou periodo anterior fora do calendario.
Feridos mes anterior =
VAR _Datas = DATEADD(dCalendario[Data], -1, MONTH)
RETURN IF(HASONEVALUE(dCalendario[AnoMesOrdem]) && NOT ISEMPTY(_Datas), CALCULATE([Pessoas feridas], _Datas))

-- Pasta: 05 Temporal\Feridos
-- Diferenca do valor atual para o mes anterior no mesmo recorte; BLANK sem mes anterior elegivel. Para gravidade, a diferenca e de proporcoes, exibida em pontos percentuais.
Feridos variacao mensal absoluta =
VAR _Anterior = [Feridos mes anterior] RETURN IF(NOT ISBLANK(_Anterior), [Pessoas feridas] - _Anterior)

-- Pasta: 05 Temporal\Feridos
-- Variacao relativa contra o mes anterior. DIVIDE retorna BLANK se o valor anterior for zero ou ausente. Nao e limitada a 0-100%, pois e variacao, nao participacao.
Feridos variacao mensal percentual =
VAR _Anterior = [Feridos mes anterior] RETURN IF(NOT ISBLANK(_Anterior), DIVIDE([Pessoas feridas] - _Anterior, _Anterior))

-- Pasta: 05 Temporal\Gravidade percentual
-- Requer um unico ano-mes no contexto. Desloca somente o calendario em um mes e preserva os filtros das outras dimensoes. BLANK para selecao de varios meses ou periodo anterior fora do calendario.
Gravidade percentual mes anterior =
VAR _Datas = DATEADD(dCalendario[Data], -1, MONTH)
RETURN IF(HASONEVALUE(dCalendario[AnoMesOrdem]) && NOT ISEMPTY(_Datas), CALCULATE([Percentual grave ou fatal], _Datas))

-- Pasta: 05 Temporal\Gravidade percentual
-- Diferenca do valor atual para o mes anterior no mesmo recorte; BLANK sem mes anterior elegivel. Para gravidade, a diferenca e de proporcoes, exibida em pontos percentuais.
Gravidade percentual variacao mensal absoluta =
VAR _Anterior = [Gravidade percentual mes anterior] VAR _Atual = [Percentual grave ou fatal] RETURN IF(NOT ISBLANK(_Anterior) && NOT ISBLANK(_Atual), (_Atual - _Anterior) * 100)

-- Pasta: 05 Temporal\Gravidade percentual
-- Variacao relativa contra o mes anterior. DIVIDE retorna BLANK se o valor anterior for zero ou ausente. Nao e limitada a 0-100%, pois e variacao, nao participacao.
Gravidade percentual variacao mensal percentual =
VAR _Anterior = [Gravidade percentual mes anterior] RETURN IF(NOT ISBLANK(_Anterior), DIVIDE([Percentual grave ou fatal] - _Anterior, _Anterior))

-- Pasta: 05 Temporal
-- Mediana das proporcoes mensais entre os meses do contexto com ocorrencias. Meses sem ocorrencias sao excluidos, nao convertidos em zero. Nao e mediana de OTIF.
Mediana mensal percentual grave ou fatal =
VAR _Meses = FILTER(VALUES(dCalendario[AnoMes]), NOT ISBLANK(CALCULATE([Percentual grave ou fatal])))
RETURN MEDIANX(_Meses, CALCULATE([Percentual grave ou fatal]))

-- Pasta: 05 Temporal\Acidentes
-- Mesmo conjunto de datas deslocado em um ano. Requer um unico ano; preserva os outros filtros. BLANK se o periodo anterior estiver fora do calendario.
Acidentes ano anterior =
VAR _Datas = DATEADD(dCalendario[Data], -1, YEAR)
RETURN IF(HASONEVALUE(dCalendario[Ano]) && NOT ISEMPTY(_Datas), CALCULATE([Acidentes], _Datas))

-- Pasta: 05 Temporal\Acidentes
-- Variacao relativa anual sob o mesmo contexto dimensional. BLANK para anterior zero/ausente ou selecao sem um unico ano.
Acidentes variacao anual percentual =
VAR _Anterior = [Acidentes ano anterior] RETURN IF(NOT ISBLANK(_Anterior), DIVIDE([Acidentes] - _Anterior, _Anterior))

-- Pasta: 05 Temporal\Mortes
-- Mesmo conjunto de datas deslocado em um ano. Requer um unico ano; preserva os outros filtros. BLANK se o periodo anterior estiver fora do calendario.
Mortes ano anterior =
VAR _Datas = DATEADD(dCalendario[Data], -1, YEAR)
RETURN IF(HASONEVALUE(dCalendario[Ano]) && NOT ISEMPTY(_Datas), CALCULATE([Mortes registradas], _Datas))

-- Pasta: 05 Temporal\Mortes
-- Variacao relativa anual sob o mesmo contexto dimensional. BLANK para anterior zero/ausente ou selecao sem um unico ano.
Mortes variacao anual percentual =
VAR _Anterior = [Mortes ano anterior] RETURN IF(NOT ISBLANK(_Anterior), DIVIDE([Mortes registradas] - _Anterior, _Anterior))

-- Pasta: 05 Temporal\Feridos
-- Mesmo conjunto de datas deslocado em um ano. Requer um unico ano; preserva os outros filtros. BLANK se o periodo anterior estiver fora do calendario.
Feridos ano anterior =
VAR _Datas = DATEADD(dCalendario[Data], -1, YEAR)
RETURN IF(HASONEVALUE(dCalendario[Ano]) && NOT ISEMPTY(_Datas), CALCULATE([Pessoas feridas], _Datas))

-- Pasta: 05 Temporal\Feridos
-- Variacao relativa anual sob o mesmo contexto dimensional. BLANK para anterior zero/ausente ou selecao sem um unico ano.
Feridos variacao anual percentual =
VAR _Anterior = [Feridos ano anterior] RETURN IF(NOT ISBLANK(_Anterior), DIVIDE([Pessoas feridas] - _Anterior, _Anterior))
